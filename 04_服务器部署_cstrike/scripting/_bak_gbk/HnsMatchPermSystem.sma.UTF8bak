#include <amxmodx>
#include <amxmisc>
#include <reapi>
#include <PersistentDataStorage>

// ============================================================
//  HNS 权限系统 (重写版)
//  核心原则:
//   1. 权限完全由 configs/permsystem/perm_list.txt 管理认证
//       (唯一权威, 与 users.ini 完全无关)
//      (唯一权威, 玩家不在名单里 = 普通玩家)
//   2. 最高服主(等级4)由源码 OWNER_AUTH 硬编码, 免认证,
//      无需在 perm_list.ini 登记, 永远拥有最高服主权限
//   3. 纸面权限(ini 文件定义): VIP=踢人, 管理员=封禁+踢人+完整管理
//   4. 全部中文文案, 无乱码
// ============================================================

// ============================================================
//  权限等级定义
// ============================================================
#define PERM_NONE    0    // 普通玩家
#define PERM_TEMP    1    // 临时
#define PERM_VIP     2    // VIP (可踢人)
#define PERM_ADMIN   3    // 管理员 (完整管理权限)
#define PERM_OWNER   4    // 最高服主 (最高权限)

// ============================================================
//  常量
// ============================================================
#define MAX_BANS         512
#define MAX_PAGE_SIZE    7
#define MAX_AUTH_LEN     64
#define MAX_NAME_LEN     32
#define MAX_REASON_LEN   128
#define PERM_STORAGE_VERSION 2

// 配置文件路径 (ini 为权威)
#define PERM_FILE   "permsystem/perm_list.txt"
#define BAN_FILE    "permsystem/ban_list.txt"

// ============================================================
//  硬编码最高服主 (无需在 perm_list.txt 登记)
//  说明: 该认证ID(SteamID或IP)的玩家永远拥有最高服主权限,
//        即使 perm_list.txt 被清除/重建也不会丢失.
//        修改后需重新编译.
//  示例: #define OWNER_AUTH  "STEAM_0:1:12345678"
//        #define OWNER_AUTH  "192.168.1.100"
// ============================================================
#define OWNER_AUTH  "STEAM_0:1:0"

// ============================================================
//  全局变量
// ============================================================

// 玩家权限等级(来自ini)
new g_iPermLevel[33];

// 玩家认证ID (SteamID 或 IP)
new g_szAuth[33][MAX_AUTH_LEN];

// 菜单翻页
new g_iPage[33];

// 当前操作类型
// 0=无, 1=踢人, 2=封禁, 3=发管理, 4=发VIP, 5=清权限, 6=转队
new g_iMenuAction[33];

// 封禁列表
new g_szBannedAuth[MAX_BANS][MAX_AUTH_LEN];
new g_iBanExpire[MAX_BANS];
new g_szBanReason[MAX_BANS][MAX_REASON_LEN];
new g_iBanCount = 0;

// 换图菜单翻页
new g_iMapPage[33];

// 地图列表
new g_szMapList[256][64];
new g_iMapCount = 0;

// ============================================================
//  权限判定核心
// ============================================================

// 是否完整管理权限 (管理员及以上)
// 管理员(PERM_ADMIN)和最高服主(PERM_OWNER)均拥有完整管理权限
// ★ 兼容: 同时认可 AMXX 原生 users.ini 授权的高级管理员(A/B 或 ADMIN 级 flag),
//   避免"只在 users.ini 配了权限、在这个插件里却打不开管理菜单"的问题。
stock bool:is_full_admin(id)
{
	if (!is_user_connected(id)) return false;

	if (g_iPermLevel[id] >= PERM_ADMIN)
		return true;

	// AMXX 原生管理员兜底: ADMIN_KICK(c) / ADMIN_BAN(d) / ADMIN_CONFIG(g) / 全权(m)
	new iFlags = get_user_flags(id);
	if (iFlags & (read_flags("c") | read_flags("d") | read_flags("g") | read_flags("m")))
		return true;

	return false;
}

// 是否最高服主 (最高权限)
// ★ 兼容: 服主可来自 ini (PERM_OWNER)、硬编码 OWNER_AUTH、或 AMXX 全权(m)
stock bool:is_owner(id)
{
	if (!is_user_connected(id)) return false;

	if (g_iPermLevel[id] == PERM_OWNER)
		return true;

	return ((get_user_flags(id) & read_flags("m")) != 0);
}

// ============================================================
//  旧版 show_menu 菜单回调 key 转换
//  说明: show_menu/register_menucmd 的回调参数 key 并不是
//        0-9 的顺序值, 而是"位值"(bit):
//        数字键1→1, 数字键2→2, 数字键3→4, 数字键4→8, ...,
//        数字键9→256, 数字键0→512。
//        本插件所有 handler 都用 switch(key){ case 0,1,2,... }
//        的顺序写法, 导致按键与选项错位、多数选项静默失灵
//        (踢人/封禁/翻页/返回都无反应)。
//        此函数把位值转成 0-9 顺旬索引, 使 case 0..9 正确命中。
// ============================================================
stock menu_key_to_number(key)
{
	for (new i = 0; i < 10; i++)
	{
		if (key & (1 << i))
			return i;
	}
	return -1;
}

// 是否具备完整管理权限 (兼容旧调用名)
stock bool:has_full_admin(id)
{
	return is_full_admin(id);
}

// 应用玩家权限标志
// 按 ini 等级授予对应管理标志 (与 hns_match system 保持一致)
//  ★ VIP(2) = b(预留通道) + e(踢人) → 注释"VIP可踢人"才名副其实
//  ★ 管理员(3) = cdefikl → 封禁(d)+临时封禁(c)+踢人(e)+配置(f)+slay(k)+拍打(l),
//     补上此前缺失的 l(slap)/k(slay), 否则管理员无法拍打人
//  ★ 服主(4) = 最高权限 m, 免认证硬编码即得
stock perm_apply_user_flags(id)
{
	if (!is_user_connected(id))
		return;

	new iFlags = get_user_flags(id);

	// 清除插件曾授予的纸面权限标志, 避免残留, 防止旧 flag 干扰重新判定
	iFlags &= ~(read_flags("b") | read_flags("c") | read_flags("d") | read_flags("e")
		| read_flags("f") | read_flags("i") | read_flags("k") | read_flags("l") | read_flags("u"));

	switch (g_iPermLevel[id]) {
		case PERM_OWNER: set_user_flags(id, iFlags | read_flags("m"));       // 服主: 最高权限
		case PERM_ADMIN: set_user_flags(id, iFlags | read_flags("cdefikl")); // 管理员: 封禁+临时封禁+踢人+拍打+slay
		case PERM_VIP:   set_user_flags(id, iFlags | read_flags("be"));      // VIP: 预留通道+踢人
		case PERM_TEMP:  set_user_flags(id, iFlags | read_flags("f"));       // 临时
		default:         set_user_flags(id, iFlags);
	}
}

// 判断是否为局域网/非Steam认证 (需用IP匹配)
// 处理: STEAM_ID_LAN / VALVE_ID_LAN / STEAM_ID_PENDING / STEAM_0:4:开头
stock bool:is_lan_auth(const szAuth[])
{
	if (equali(szAuth, "STEAM_ID_LAN") || equali(szAuth, "VALVE_ID_LAN") || equali(szAuth, "STEAM_ID_PENDING"))
		return true;

	// STEAM_0:4: 开头 (部分非Steam/破解服返回), 前缀匹配
	if (strncmp(szAuth, "STEAM_0:4:", 10, false) == 0)
		return true;

	return false;
}

// 灵活的认证匹配
// 支持: 完全匹配(大小写不敏感) / STEAM_0 <-> STEAM_1 互换匹配
// 现代Steam返回 STEAM_1:Y:Z, 旧名单常写 STEAM_0:Y:Z, 两者代表同一玩家
stock bool:perm_auth_match(const szFileAuth[], const szPlayerAuth[])
{
	// 完全匹配 (大小写不敏感)
	if (equali(szFileAuth, szPlayerAuth))
		return true;

	// STEAM_0 <-> STEAM_1 互换匹配
	if ((strncmp(szFileAuth, "STEAM_0:", 8, false) == 0 && strncmp(szPlayerAuth, "STEAM_1:", 8, false) == 0) ||
	    (strncmp(szFileAuth, "STEAM_1:", 8, false) == 0 && strncmp(szPlayerAuth, "STEAM_0:", 8, false) == 0)) {
		// 比较前缀之后的 Y:Z 部分
		if (equali(szFileAuth[8], szPlayerAuth[8]))
			return true;
	}

	return false;
}

// ============================================================
//  插件信息
// ============================================================
public plugin_init()
{
	register_plugin("HNS PermSystem", "5.4.0", "HNS Match System");

	// 命令注册
	register_clcmd("say /vipadmin", "cmdVipAdmin");
	register_clcmd("say /permcheck", "cmdPermCheck");
	register_clcmd("say /clearperm", "cmdClearPermData");   // 清除全部权限数据(仅管理员)
	register_clcmd("say /giveperm", "cmdGivePerm");          // 在线发放权限
	register_clcmd("say /permdebug", "cmdPermDebug");        // 权限调试(自查认证ID/等级/名单)
	register_clcmd("say", "cmdSayHandler");

	// ---- 皮肤/IC点发放管控 (ini 管理员) ----
	// 皮肤发放: 仅 ini 管理员可用
	register_clcmd("say /giveskin",     "cmdSkinGiveGate");
	register_clcmd("say /giveskinmenu", "cmdSkinGiveGate");
	register_clcmd("say /giveskinid",   "cmdSkinGiveGate");
	register_clcmd("say /giveallskins", "cmdSkinGiveGate");
	register_clcmd("say /adminskin",    "cmdSkinGiveGate");
	// IC点发放
	register_clcmd("say /givecoin",   "cmdSkinGiveGate");
	register_clcmd("say /givecoins",  "cmdSkinGiveGate");
	register_clcmd("hns_give_coin",   "cmdSkinGiveGate");

	// 菜单注册
	register_menucmd(register_menuid("Perm Main"), 1023, "handlePermMain");
	register_menucmd(register_menuid("Perm Select Player"), 1023, "handlePermSelectPlayer");
	register_menucmd(register_menuid("Perm Kick Reason"), 1023, "handlePermKickReason");
	register_menucmd(register_menuid("Perm Ban Time"), 1023, "handlePermBanTime");
	register_menucmd(register_menuid("Admin Menu"), 1023, "handleAdminMenu");
	register_menucmd(register_menuid("Perm Map List"), 1023, "handlePermMapList");

	// 创建权限目录 (必须先创建, 否则自动生成配置文件会失败)
	new szDir[128];
	get_configsdir(szDir, charsmax(szDir));
	format(szDir, charsmax(szDir), "%s/permsystem", szDir);
	if (!dir_exists(szDir)) {
		mkdir(szDir);
	}

	// 加载封禁列表(ini权威)
	load_bans_file();

	// 加载地图列表
	load_map_list();
}

// 换图后重新应用所有在线玩家的纸面权限标志
// 原因: AMXX 在换图时会重置访问标志, 插件用 set_user_flags 授予的
//       纸面 b/defiu 标志会丢失, 导致"掉管理". 这里统一重新应用.
public plugin_cfg()
{
	new players[32], num;
	get_players(players, num);

	for (new i = 0; i < num; i++) {
		perm_apply_user_flags(players[i]);
	}
}

// ============================================================
//  玩家连接/断开
// ============================================================
public client_putinserver(id)
{
	g_iPermLevel[id] = PERM_NONE;
	g_iPage[id] = 0;
	g_iMenuAction[id] = 0;
	g_iMapPage[id] = 0;
	g_szAuth[id][0] = '^0';

	if (is_user_bot(id) || is_user_hltv(id))
		return;

	// 获取认证信息 (SteamID 或 IP)
	new szAuth[MAX_AUTH_LEN];
	get_user_authid(id, szAuth, charsmax(szAuth));

	if (is_lan_auth(szAuth)) {
		get_user_ip(id, g_szAuth[id], charsmax(g_szAuth[]), 1);
	} else {
		copy(g_szAuth[id], charsmax(g_szAuth[]), szAuth);
	}

	// 从 ini 加载纸面权限
	perm_load(id);
	perm_apply_user_flags(id);

	// 检查封禁
	check_ban(id);
}

public client_authorized(id)
{
	if (is_user_bot(id) || is_user_hltv(id))
		return;

	// Steam验证后重新加载权限(SteamID更准确)
	new szAuth[MAX_AUTH_LEN];
	get_user_authid(id, szAuth, charsmax(szAuth));

	if (!is_lan_auth(szAuth)) {
		copy(g_szAuth[id], charsmax(g_szAuth[]), szAuth);
	}

	perm_load(id);
	perm_apply_user_flags(id);

	check_ban(id);
}

public client_disconnected(id)
{
	g_iPermLevel[id] = PERM_NONE;
	g_iPage[id] = 0;
	g_iMenuAction[id] = 0;
	g_iMapPage[id] = 0;
	g_szAuth[id][0] = '^0';
}

// ============================================================
//  命令: /vipadmin - 打开权限管理菜单 (仅 ini 管理员)
// ============================================================
public cmdVipAdmin(id)
{
	if (!is_user_connected(id))
		return PLUGIN_HANDLED;

	// 仅 ini 管理员可打开
	if (!has_full_admin(id)) {
		client_print(id, print_chat, "[权限] 只有 ini 管理员才能打开权限管理菜单");
		return PLUGIN_HANDLED;
	}

	show_perm_main_menu(id);
	return PLUGIN_HANDLED;
}

// ============================================================
//  命令: /giveperm - ini 管理员在线发放权限
//  用法: /giveperm <玩家名|@ALL> <等级>  (等级: 0=清除 2=VIP 3=管理员 4=服主)
// ============================================================
public cmdGivePerm(id)
{
	if (!is_user_connected(id))
		return PLUGIN_HANDLED;

	if (!has_full_admin(id)) {
		client_print(id, print_chat, "[权限] 只有 ini 管理员才能发放权限");
		return PLUGIN_HANDLED;
	}

	new szArgs[192];
	read_args(szArgs, charsmax(szArgs));
	remove_quotes(szArgs);
	trim(szArgs);

	new szTarget[32], szLevel[8];
	parse(szArgs, szTarget, charsmax(szTarget), szLevel, charsmax(szLevel));

	if (!szTarget[0] || !szLevel[0]) {
		client_print(id, print_chat, "[权限] 用法: /giveperm <玩家名|@ALL> <等级>  (0=清除 2=VIP 3=管理员 4=服主)");
		return PLUGIN_HANDLED;
	}

	new iLevel = str_to_num(szLevel);
	if (iLevel != PERM_NONE && iLevel != PERM_VIP && iLevel != PERM_ADMIN && iLevel != PERM_OWNER) {
		client_print(id, print_chat, "[权限] 等级无效, 只能是 0(清除) 2(VIP) 3(管理员) 4(服主)");
		return PLUGIN_HANDLED;
	}

	// @ALL: 发放给所有在线玩家
	if (equali(szTarget, "@ALL")) {
		new players[32], num;
		get_players(players, num);
		for (new i = 0; i < num; i++) {
			g_iPermLevel[players[i]] = iLevel;
			perm_apply_user_flags(players[i]);
		}
		perm_save_file();
		client_print(0, print_chat, "[权限] 管理员已将全部在线玩家权限设为等级 %d", iLevel);
		return PLUGIN_HANDLED;
	}

	// 找目标玩家(支持部分名字匹配)
	new target = cmd_target(id, szTarget, CMDTARGET_ALLOW_SELF);
	if (!target) {
		client_print(id, print_chat, "[权限] 找不到玩家: %s", szTarget);
		return PLUGIN_HANDLED;
	}

	set_player_perm(target, iLevel, id);

	return PLUGIN_HANDLED;
}

// 设置玩家权限并持久化
stock set_player_perm(target, iLevel, admin)
{
	g_iPermLevel[target] = iLevel;
	perm_apply_user_flags(target);
	perm_save_file();

	new szName[32];
	get_user_name(target, szName, charsmax(szName));

	if (iLevel == PERM_NONE) {
		client_print(admin, print_chat, "[权限] 已清除 %s 的纸面权限", szName);
		client_print(target, print_chat, "[权限] 你的权限已被管理员清除");
	} else if (iLevel == PERM_VIP) {
		client_print(admin, print_chat, "[权限] 已将 %s 设为 VIP (可踢人)", szName);
		client_print(target, print_chat, "[权限] 你已被管理员授予 VIP 权限 (可踢人)");
	} else if (iLevel == PERM_ADMIN) {
		client_print(admin, print_chat, "[权限] 已将 %s 设为 管理员 (完整管理权限)", szName);
		client_print(target, print_chat, "[权限] 你已被管理员授予 管理员 权限 (完整管理权限)");
	} else if (iLevel == PERM_OWNER) {
		client_print(admin, print_chat, "[权限] 已将 %s 设为 最高服主 (最高权限)", szName);
		client_print(target, print_chat, "[权限] 你已被授予 最高服主 权限 (最高权限)");
	}
}

// ============================================================
//  命令: /clearperm - 清除全部权限数据 (仅 ini 管理员)
// ============================================================
public cmdClearPermData(id)
{
	if (!is_user_connected(id))
		return PLUGIN_HANDLED;

	if (!has_full_admin(id)) {
		client_print(id, print_chat, "[权限] 只有管理员才能清除权限数据");
		return PLUGIN_HANDLED;
	}

	// 清空内存中的纸面权限
	new players[32], num;
	get_players(players, num);
	for (new i = 0; i < num; i++) {
		g_iPermLevel[players[i]] = PERM_NONE;
		// 硬编码服主不受清除影响
		if (perm_auth_match(OWNER_AUTH, g_szAuth[players[i]])) {
			g_iPermLevel[players[i]] = PERM_OWNER;
		}
		perm_apply_user_flags(players[i]);
	}

	// 删除 ini 文件并在 ini 文件里写入空清单
	perm_reset_file();

	// 清空 PDS 相关键(旧数据)
	pds_clear_perm_keys();

	client_print(0, print_chat, "[权限] 管理员已清除全部权限数据, 所有玩家回到普通权限");
	return PLUGIN_HANDLED;
}

// 清空PDS中的权限键(旧数据)
stock pds_clear_perm_keys()
{
	// PDS 不支持遍历删除, 通过写入无效值覆盖旧格式键
	// 由于 ini 为权威, 旧 PDS 键即使存在也不再被读取
	// 这里仅做标记, 确保旧数据不被使用
	PDS_SetCell("hns_perm_data_cleared", 1);
}

// ============================================================
//  命令: /permcheck - 查看自己权限等级
// ============================================================
public cmdPermCheck(id)
{
	if (!is_user_connected(id))
		return PLUGIN_HANDLED;

	new szLevel[32];
	switch (g_iPermLevel[id]) {
		case PERM_OWNER: copy(szLevel, charsmax(szLevel), "最高服主 (最高权限)");
		case PERM_ADMIN: copy(szLevel, charsmax(szLevel), "管理员 (完整管理权限)");
		case PERM_VIP:   copy(szLevel, charsmax(szLevel), "VIP (可踢人)");
		case PERM_TEMP:  copy(szLevel, charsmax(szLevel), "临时权限");
		default:         copy(szLevel, charsmax(szLevel), "普通玩家");
	}

	client_print(id, print_chat, "[权限] 你的权限等级: %s", szLevel);

	return PLUGIN_HANDLED;
}

// ============================================================
//  命令: /permdebug - 权限调试 (查看认证ID/等级/名单内容)
//  用于排查"我在ini里登记了权限但打不开菜单"的问题
// ============================================================
public cmdPermDebug(id)
{
	if (!is_user_connected(id))
		return PLUGIN_HANDLED;

	new szDir[128];
	get_configsdir(szDir, charsmax(szDir));
	new szFile[256];
	formatex(szFile, charsmax(szFile), "%s/%s", szDir, PERM_FILE);

	client_print(id, print_chat, "[权限调试] 你的认证ID: %s", g_szAuth[id]);
	client_print(id, print_chat, "[权限调试] 你的权限等级: %d (3=管理员 4=服主)", g_iPermLevel[id]);
	client_print(id, print_chat, "[权限调试] 详细内容已输出到控制台 (按 ~ 键查看)");

	client_print(id, print_console, "===== HNS 权限调试 =====");
	client_print(id, print_console, "认证ID: %s", g_szAuth[id]);
	client_print(id, print_console, "权限等级: %d (3=管理员 4=服主)", g_iPermLevel[id]);
	client_print(id, print_console, "权限文件: %s", szFile);

	new fp = fopen(szFile, "rt");
	if (!fp) {
		client_print(id, print_console, "错误: 找不到权限文件!");
		return PLUGIN_HANDLED;
	}

	client_print(id, print_console, "--- 权限文件内容 ---");
	new szLine[256];
	new iLine = 0;
	while (!feof(fp) && iLine < 30) {
		fgets(fp, szLine, charsmax(szLine));
		trim(szLine);
		if (szLine[0] != '^0') {
			client_print(id, print_console, "%s", szLine);
			iLine++;
		}
	}
	fclose(fp);

	client_print(id, print_console, "--- 提示 ---");
	client_print(id, print_console, "若认证ID是IP地址, 请在ini里写你的IP而不是SteamID");
	client_print(id, print_console, "若认证ID是STEAM_1开头而ini写STEAM_0, 新版已自动兼容");

	return PLUGIN_HANDLED;
}

// ============================================================
//  皮肤/IC点发放管控 (ini 管理员)
//  规则: 仅 ini 管理员才能发放皮肤/IC点
//        (复用 has_full_admin, 与权限发放同一套控制)
//        普通玩家/VIP 即使持 b/defiu 标志也不放行
// ============================================================
public cmdSkinGiveGate(const id)
{
	if (!is_user_connected(id))
		return PLUGIN_HANDLED;

	// 非 ini 管理员 → 拦截
	if (!has_full_admin(id)) {
		client_print(id, print_chat, "[皮肤] 只有 ini 管理员才能发放皮肤/IC点");
		return PLUGIN_HANDLED;
	}

	// 管理员 → 放行, 由原皮肤插件正常处理
	return PLUGIN_CONTINUE;
}

// ============================================================
//  聊天拦截
// ============================================================
public cmdSayHandler(id)
{
	return PLUGIN_CONTINUE;
}

// ============================================================
//  主菜单 (仅 ini 管理员进入, 用于发放权限)
// ============================================================
show_perm_main_menu(id)
{
	if (!is_user_connected(id))
		return;

	if (!has_full_admin(id)) {
		client_print(id, print_chat, "[权限] 只有 ini 管理员才能操作");
		return;
	}

	new szMenu[512];
	new len;

	len = formatex(szMenu, charsmax(szMenu), "\y[权限管理 - 管理员]\w^n^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r1. \w发放管理员权限^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r2. \w发放VIP权限^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r3. \w清除权限^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r4. \w在线权限列表^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r5. \w管理菜单^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "^n\r0. \w退出");

	show_menu(id, 1023, szMenu, -1, "Perm Main");
}

public handlePermMain(id, key)
{
	if (!is_user_connected(id))
		return;

	if (!has_full_admin(id)) {
		client_print(id, print_chat, "[权限] 只有 ini 管理员才能操作");
		return;
	}

	key = menu_key_to_number(key);

	switch (key) {
		case 0: { g_iMenuAction[id] = 3; g_iPage[id] = 0; show_select_player_menu(id); }
		case 1: { g_iMenuAction[id] = 4; g_iPage[id] = 0; show_select_player_menu(id); }
		case 2: { g_iMenuAction[id] = 5; g_iPage[id] = 0; show_select_player_menu(id); }
		case 3: { show_online_perm_list(id); }
		case 4: { show_admin_menu(id); }
		case 9: { return; }
	}
}

// ============================================================
//  在线权限列表
// ============================================================
show_online_perm_list(id)
{
	new szMenu[1024];
	new len;
	new iCount = 0;

	len = formatex(szMenu, charsmax(szMenu), "\y[在线权限列表]\w^n^n");

	new players[32], num;
	get_players(players, num);

	for (new i = 0; i < num && iCount < 9; i++) {
		new pid = players[i];
		new szPermName[32];

		switch (g_iPermLevel[pid]) {
			case PERM_OWNER: copy(szPermName, charsmax(szPermName), "服主");
			case PERM_ADMIN: copy(szPermName, charsmax(szPermName), "管理员");
			case PERM_VIP:   copy(szPermName, charsmax(szPermName), "VIP");
			case PERM_TEMP:  copy(szPermName, charsmax(szPermName), "临时");
			default:         copy(szPermName, charsmax(szPermName), "普通");
		}

		new szPlayerName[32];
		get_user_name(pid, szPlayerName, charsmax(szPlayerName));

		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r%d. \w%s \y(%s)^n", iCount + 1, szPlayerName, szPermName);
		iCount++;
	}

	if (iCount == 0) {
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\d当前没有在线玩家^n");
	}

	len += formatex(szMenu[len], charsmax(szMenu) - len, "^n\r0. \w返回");

	show_menu(id, 1023, szMenu, -1, "Perm Main");
}

// ============================================================
//  选择玩家菜单
// ============================================================
show_select_player_menu(id)
{
	if (!is_user_connected(id))
		return;

	new players[32], num;
	get_players(players, num);

	if (num == 0) {
		client_print(id, print_chat, "[权限] 当前没有在线玩家");
		return;
	}

	new iMaxPages = (num - 1) / MAX_PAGE_SIZE + 1;
	if (g_iPage[id] < 0) g_iPage[id] = 0;
	if (g_iPage[id] >= iMaxPages) g_iPage[id] = iMaxPages - 1;

	new iStart = g_iPage[id] * MAX_PAGE_SIZE;
	new iEnd = iStart + MAX_PAGE_SIZE;
	if (iEnd > num) iEnd = num;

	new szMenu[1024];
	new len;

	len = formatex(szMenu, charsmax(szMenu), "\y[选择玩家] \w%d/%d^n^n", g_iPage[id] + 1, iMaxPages);

	for (new i = iStart; i < iEnd; i++) {
		new pid = players[i];
		new szPlayerName[32];
		get_user_name(pid, szPlayerName, charsmax(szPlayerName));

		new szPermName[24];
		switch (g_iPermLevel[pid]) {
			case PERM_OWNER: copy(szPermName, charsmax(szPermName), "服主");
			case PERM_ADMIN: copy(szPermName, charsmax(szPermName), "管理员");
			case PERM_VIP:   copy(szPermName, charsmax(szPermName), "VIP");
			case PERM_TEMP:  copy(szPermName, charsmax(szPermName), "临时");
			default:         copy(szPermName, charsmax(szPermName), "普通");
		}

		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r%d. \w%s \y(%s)^n", (i - iStart) + 1, szPlayerName, szPermName);
	}

	len += formatex(szMenu[len], charsmax(szMenu) - len, "^n");

	if (g_iPage[id] > 0) {
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r8. \w上一页^n");
	} else {
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\d8. 上一页^n");
	}

	if (g_iPage[id] < iMaxPages - 1) {
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r9. \w下一页^n");
	} else {
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\d9. 下一页^n");
	}

	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r0. \w返回");

	show_menu(id, 1023, szMenu, -1, "Perm Select Player");
}

public handlePermSelectPlayer(id, key)
{
	if (!is_user_connected(id))
		return;

	// 权限校验:
	// - 踢人(action=1): VIP 及以上可踢 (INI 定义 VIP=可踢人)
	// - 封禁/发权限/清权限: 管理员及以上
	switch (g_iMenuAction[id]) {
		case 1: {
			if (!is_full_admin(id) && g_iPermLevel[id] != PERM_VIP) {
				client_print(id, print_chat, "[权限] 只有 VIP 及以上才能踢人");
				return;
			}
		}
		default: {
			if (!has_full_admin(id)) {
				client_print(id, print_chat, "[权限] 只有 ini 管理员才能操作");
				return;
			}
		}
	}

	key = menu_key_to_number(key);

	new players[32], num;
	get_players(players, num);

	new iMaxPages = (num - 1) / MAX_PAGE_SIZE + 1;

	switch (key) {
		case 0, 1, 2, 3, 4, 5, 6: {
			new iIndex = g_iPage[id] * MAX_PAGE_SIZE + key;
			if (iIndex >= num) {
				show_select_player_menu(id);
				return;
			}

			new target = players[iIndex];

			switch (g_iMenuAction[id]) {
				case 1: {
					// 踢人: 校验能否踢目标, 通过后进理由菜单
					if (can_kick_target(id, target)) {
						show_kick_reason_menu(id, target);
					} else {
						client_print(id, print_chat, "[权限] 你无法踢出该玩家");
						show_select_player_menu(id);
					}
				}
				case 2: {
					// 封禁: 校验能否封禁目标, 通过后进封禁时间菜单
					if (can_kick_target(id, target)) {
						show_ban_time_menu(id, target);
					} else {
						client_print(id, print_chat, "[权限] 你无法封禁该玩家");
						show_select_player_menu(id);
					}
				}
				case 3: {
					// 发管理权限
					g_iPermLevel[target] = PERM_ADMIN;
					perm_apply_user_flags(target);
					perm_save_file();

					new szTargetName[32];
					get_user_name(target, szTargetName, charsmax(szTargetName));
					client_print(id, print_chat, "[权限] 已将 %s 设为 管理员", szTargetName);
					client_print(target, print_chat, "[权限] 你已被授予管理员权限 (可封禁+踢人)");

					show_perm_main_menu(id);
				}
				case 4: {
					// 发VIP权限
					g_iPermLevel[target] = PERM_VIP;
					perm_apply_user_flags(target);
					perm_save_file();

					new szTargetName[32];
					get_user_name(target, szTargetName, charsmax(szTargetName));
					client_print(id, print_chat, "[权限] 已将 %s 设为 VIP", szTargetName);
					client_print(target, print_chat, "[权限] 你已被授予VIP权限 (可踢人)");

					show_perm_main_menu(id);
				}
				case 5: {
					// 清除权限
					g_iPermLevel[target] = PERM_NONE;
					perm_apply_user_flags(target);
					perm_save_file();

					new szTargetName[32];
					get_user_name(target, szTargetName, charsmax(szTargetName));
					client_print(id, print_chat, "[权限] 已清除 %s 的权限", szTargetName);
					client_print(target, print_chat, "[权限] 你的权限已被管理员清除");

					show_perm_main_menu(id);
				}
				case 6: {
					// 转移队伍
					transfer_player_team(id, target);
					show_select_player_menu(id);
				}
				default: {
					show_perm_main_menu(id);
				}
			}
		}
		case 7: {
			if (g_iPage[id] > 0) g_iPage[id]--;
			show_select_player_menu(id);
		}
		case 8: {
			if (g_iPage[id] < iMaxPages - 1) g_iPage[id]++;
			show_select_player_menu(id);
		}
		case 9: {
			show_perm_main_menu(id);
		}
	}
}

// ============================================================
//  踢人理由菜单
// ============================================================
show_kick_reason_menu(id, target)
{
	new szMenu[512];
	new len;

	len = formatex(szMenu, charsmax(szMenu), "\y[踢人理由]\w^n^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r1. \w违规行为^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r2. \w挂机/AFK^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r3. \w辱骂他人^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r4. \w恶意干扰^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r5. \w其他^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "^n\r0. \w取消");

	g_iPage[id] = target;

	show_menu(id, 1023, szMenu, -1, "Perm Kick Reason");
}

public handlePermKickReason(id, key)
{
	new target = g_iPage[id];
	g_iPage[id] = 0;

	key = menu_key_to_number(key);

	if (key == 9) {
		g_iMenuAction[id] = 1;
		g_iPage[id] = 0;
		show_select_player_menu(id);
		return;
	}

	new szReason[128];
	switch (key) {
		case 0: copy(szReason, charsmax(szReason), "违规行为");
		case 1: copy(szReason, charsmax(szReason), "挂机/AFK");
		case 2: copy(szReason, charsmax(szReason), "辱骂他人");
		case 3: copy(szReason, charsmax(szReason), "恶意干扰");
		case 4: copy(szReason, charsmax(szReason), "其他");
		default: copy(szReason, charsmax(szReason), "未知");
	}

	new szTargetName[32];
	get_user_name(target, szTargetName, charsmax(szTargetName));
	new szAdminName[32];
	get_user_name(id, szAdminName, charsmax(szAdminName));

	client_print(0, print_chat, "[权限] %s 已被 %s 踢出 (理由: %s)", szTargetName, szAdminName, szReason);

	new param[2];
	param[0] = target;
	set_task(0.1, "task_kick_player", 0, param, 2);

	show_admin_menu(id);
}

public task_kick_player(param[2])
{
	new target = param[0];
	if (is_user_connected(target)) {
		server_cmd("kick #%d ^"你已被管理员踢出^"", get_user_userid(target));
	}
}

// ============================================================
//  封禁时间菜单
// ============================================================
show_ban_time_menu(id, target)
{
	new szMenu[512];
	new len;

	len = formatex(szMenu, charsmax(szMenu), "\y[封禁时间]\w^n^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r1. \w1小时^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r2. \w1天^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r3. \w7天^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r4. \w永久^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "^n\r0. \w取消");

	g_iPage[id] = target;

	show_menu(id, 1023, szMenu, -1, "Perm Ban Time");
}

public handlePermBanTime(id, key)
{
	new target = g_iPage[id];
	g_iPage[id] = 0;

	key = menu_key_to_number(key);

	if (key == 9) {
		g_iMenuAction[id] = 2;
		g_iPage[id] = 0;
		show_select_player_menu(id);
		return;
	}

	new iBanTime = 0; // 秒为单位, 0=永久
	new szTimeStr[32];

	switch (key) {
		case 0: { iBanTime = 3600;   copy(szTimeStr, charsmax(szTimeStr), "1小时"); }
		case 1: { iBanTime = 86400;  copy(szTimeStr, charsmax(szTimeStr), "1天");   }
		case 2: { iBanTime = 604800; copy(szTimeStr, charsmax(szTimeStr), "7天");   }
		case 3: { iBanTime = 0;      copy(szTimeStr, charsmax(szTimeStr), "永久");  }
		default: {
			show_select_player_menu(id);
			return;
		}
	}

	new iExpire = 0;
	if (iBanTime > 0) {
		iExpire = get_systime() + iBanTime;
	}

	add_ban(target, iExpire, "管理员封禁");

	new szTargetName[32];
	get_user_name(target, szTargetName, charsmax(szTargetName));
	new szAdminName[32];
	get_user_name(id, szAdminName, charsmax(szAdminName));

	client_print(0, print_chat, "[权限] %s 已被 %s 封禁 (时间: %s)", szTargetName, szAdminName, szTimeStr);

	if (is_user_connected(target)) {
		server_cmd("kick #%d ^"你已被管理员封禁 (时间: %s)^"", get_user_userid(target), szTimeStr);
	}

	show_admin_menu(id);
}

// ============================================================
//  管理菜单 (ini 权限分级: VIP=踢人, 管理员=完整管理)
// ============================================================
show_admin_menu(id)
{
	if (!is_user_connected(id))
		return;

	// 管理员: 全部管理功能
	if (is_full_admin(id)) {
		new szMenu[1024];
		new len;

		len = formatex(szMenu, charsmax(szMenu), "\y[管理菜单 - 管理员]\w^n^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r1. \w踢出玩家^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r2. \w封禁玩家^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r3. \w权限发放^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r4. \w换图^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r5. \w暂停/恢复比赛^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r6. \w转移玩家队伍^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r7. \w重开回合^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r8. \w交换队伍^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "^n\r0. \w返回");

		show_menu(id, 1023, szMenu, -1, "Admin Menu");
		return;
	}

	// 纸面管理员
	if (g_iPermLevel[id] == PERM_ADMIN) {
		new szMenu[1024];
		new len;

		len = formatex(szMenu, charsmax(szMenu), "\y[管理菜单 - 管理员]\w^n^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r1. \w踢出玩家^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r2. \w封禁玩家^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "^n\r0. \w返回");

		show_menu(id, 1023, szMenu, -1, "Admin Menu");
		return;
	}

	// 纸面 VIP
	if (g_iPermLevel[id] == PERM_VIP) {
		new szMenu[512];
		new len;

		len = formatex(szMenu, charsmax(szMenu), "\y[管理菜单 - VIP]\w^n^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r1. \w踢出玩家^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "^n\r0. \w返回");

		show_menu(id, 1023, szMenu, -1, "Admin Menu");
		return;
	}

	client_print(id, print_chat, "[权限] 你没有管理权限");
}

public handleAdminMenu(id, key)
{
	if (!is_user_connected(id))
		return;

	key = menu_key_to_number(key);

	// 管理员处理全部
	if (is_full_admin(id)) {
		switch (key) {
			case 0: { g_iMenuAction[id] = 1; g_iPage[id] = 0; show_select_player_menu(id); }
			case 1: { g_iMenuAction[id] = 2; g_iPage[id] = 0; show_select_player_menu(id); }
			case 2: { show_perm_main_menu(id); }
			case 3: { show_map_list_menu(id); }
			case 4: { toggle_pause_match(id); show_admin_menu(id); }
			case 5: { g_iMenuAction[id] = 6; g_iPage[id] = 0; show_select_player_menu(id); }
			case 6: { restart_round(id); show_admin_menu(id); }
			case 7: { swap_teams(id); show_admin_menu(id); }
			case 9: { return; }
		}
		return;
	}

	// 纸面管理员
	if (g_iPermLevel[id] == PERM_ADMIN) {
		switch (key) {
			case 0: { g_iMenuAction[id] = 1; g_iPage[id] = 0; show_select_player_menu(id); }
			case 1: { g_iMenuAction[id] = 2; g_iPage[id] = 0; show_select_player_menu(id); }
			case 9: { return; }
		}
		return;
	}

	// 纸面 VIP
	if (g_iPermLevel[id] == PERM_VIP) {
		switch (key) {
			case 0: { g_iMenuAction[id] = 1; g_iPage[id] = 0; show_select_player_menu(id); }
			case 9: { return; }
		}
		return;
	}
}

// ============================================================
//  换图菜单
// ============================================================
show_map_list_menu(id)
{
	if (!is_user_connected(id))
		return;

	if (g_iMapCount == 0) {
		client_print(id, print_chat, "[权限] 地图列表为空");
		show_admin_menu(id);
		return;
	}

	new iMaxPages = (g_iMapCount - 1) / MAX_PAGE_SIZE + 1;
	if (g_iMapPage[id] < 0) g_iMapPage[id] = 0;
	if (g_iMapPage[id] >= iMaxPages) g_iMapPage[id] = iMaxPages - 1;

	new iStart = g_iMapPage[id] * MAX_PAGE_SIZE;
	new iEnd = iStart + MAX_PAGE_SIZE;
	if (iEnd > g_iMapCount) iEnd = g_iMapCount;

	new szMenu[1024];
	new len;

	len = formatex(szMenu, charsmax(szMenu), "\y[选择地图] \w%d/%d^n^n", g_iMapPage[id] + 1, iMaxPages);

	for (new i = iStart; i < iEnd; i++) {
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r%d. \w%s^n", (i - iStart) + 1, g_szMapList[i]);
	}

	len += formatex(szMenu[len], charsmax(szMenu) - len, "^n");

	if (g_iMapPage[id] > 0) {
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r8. \w上一页^n");
	} else {
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\d8. 上一页^n");
	}

	if (g_iMapPage[id] < iMaxPages - 1) {
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r9. \w下一页^n");
	} else {
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\d9. 下一页^n");
	}

	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r0. \w返回");

	show_menu(id, 1023, szMenu, -1, "Perm Map List");
}

public handlePermMapList(id, key)
{
	if (!is_user_connected(id)) return;

	key = menu_key_to_number(key);

	new iMaxPages = (g_iMapCount - 1) / MAX_PAGE_SIZE + 1;

	switch (key) {
		case 0, 1, 2, 3, 4, 5, 6: {
			new iIndex = g_iMapPage[id] * MAX_PAGE_SIZE + key;
			if (iIndex >= g_iMapCount) {
				show_map_list_menu(id);
				return;
			}

			new szMapName[64];
			copy(szMapName, charsmax(szMapName), g_szMapList[iIndex]);

			client_print(0, print_chat, "[权限] 管理员正在切换地图到: %s", szMapName);

			new param[64];
			copy(param, charsmax(param), szMapName);
			set_task(1.0, "task_change_map", 0, param, charsmax(param));
		}
		case 7: {
			if (g_iMapPage[id] > 0) g_iMapPage[id]--;
			show_map_list_menu(id);
		}
		case 8: {
			if (g_iMapPage[id] < iMaxPages - 1) g_iMapPage[id]++;
			show_map_list_menu(id);
		}
		case 9: {
			show_admin_menu(id);
		}
	}
}

public task_change_map(param[64])
{
	new szMap[64];
	copy(szMap, charsmax(szMap), param);
	server_cmd("changelevel %s", szMap);
}

// ============================================================
//  权限检查函数
// ============================================================

// 检查踢人者能否踢目标
// 服主可踢任何人(除其他服主)
// 管理员可踢普通和VIP(不可踢服主/其他管理员)
// VIP可以踢普通玩家
can_kick_target(kicker, target)
{
	if (kicker == target) return 0;
	if (!is_user_connected(target)) return 0;

	// 服主不可被踢(任何人都不行)
	if (is_owner(target)) return 0;

	new iKickerLevel = g_iPermLevel[kicker];
	new iTargetLevel = g_iPermLevel[target];

	// 服主: 可踢管理员及以下
	if (iKickerLevel >= PERM_OWNER) return 1;

	// 管理员: 可踢 VIP/普通, 不可踢同级管理员
	if (iKickerLevel >= PERM_ADMIN) {
		if (iTargetLevel >= PERM_ADMIN) return 0;
		return 1;
	}

	// VIP: 只能踢普通玩家
	if (iKickerLevel >= PERM_VIP) return (iTargetLevel < PERM_VIP);

	return 0;
}

// ============================================================
//  管理功能实现
// ============================================================

toggle_pause_match(id)
{
	set_cvar_num("pausable", 1);
	server_cmd("pause");
	client_print(0, print_chat, "[权限] 比赛已暂停/恢复");
}

transfer_player_team(admin, target)
{
	if (!is_user_connected(target)) {
		client_print(admin, print_chat, "[权限] 目标玩家不在线");
		return;
	}

	new iTeam = get_member(target, m_iTeam);

	if (iTeam == TEAM_TERRORIST) {
		rg_set_user_team(target, TEAM_CT, MODEL_AUTO, true);
	} else if (iTeam == TEAM_CT) {
		rg_set_user_team(target, TEAM_TERRORIST, MODEL_AUTO, true);
	} else {
		rg_set_user_team(target, TEAM_CT, MODEL_AUTO, true);
	}

	new szTargetName[32];
	get_user_name(target, szTargetName, charsmax(szTargetName));
	client_print(admin, print_chat, "[权限] 已转移 %s 的队伍", szTargetName);
	client_print(target, print_chat, "[权限] 你的队伍已被管理员转移");
}

restart_round(id)
{
	server_cmd("sv_restart 1");
	client_print(0, print_chat, "[权限] 管理员已重开回合");
}

swap_teams(id)
{
	new players[32], num;
	get_players(players, num, "h");

	for (new i = 0; i < num; i++) {
		new pid = players[i];
		new iTeam = get_member(pid, m_iTeam);

		if (iTeam == TEAM_TERRORIST) {
			rg_set_user_team(pid, TEAM_CT, MODEL_AUTO, true);
		} else if (iTeam == TEAM_CT) {
			rg_set_user_team(pid, TEAM_TERRORIST, MODEL_AUTO, true);
		}
	}

	client_print(0, print_chat, "[权限] 管理员已交换所有玩家队伍");
}

// ============================================================
//  封禁系统
// ============================================================

add_ban(id, iExpire, const szReason[])
{
	if (g_iBanCount >= MAX_BANS) return;

	new szAuth[MAX_AUTH_LEN];
	get_user_authid(id, szAuth, charsmax(szAuth));

	if (is_lan_auth(szAuth)) {
		get_user_ip(id, szAuth, charsmax(szAuth), 1);
	}

	for (new i = 0; i < g_iBanCount; i++) {
		if (equal(g_szBannedAuth[i], szAuth)) {
			g_iBanExpire[i] = iExpire;
			copy(g_szBanReason[i], charsmax(g_szBanReason[]), szReason);
			save_bans_file();
			return;
		}
	}

	copy(g_szBannedAuth[g_iBanCount], charsmax(g_szBannedAuth[]), szAuth);
	g_iBanExpire[g_iBanCount] = iExpire;
	copy(g_szBanReason[g_iBanCount], charsmax(g_szBanReason[]), szReason);
	g_iBanCount++;

	save_bans_file();
}

check_ban(id)
{
	new szAuth[MAX_AUTH_LEN];
	get_user_authid(id, szAuth, charsmax(szAuth));

	if (is_lan_auth(szAuth)) {
		get_user_ip(id, szAuth, charsmax(szAuth), 1);
	}

	new iCurrentTime = get_systime();

	for (new i = 0; i < g_iBanCount; i++) {
		if (equal(g_szBannedAuth[i], szAuth)) {
			if (g_iBanExpire[i] == 0 || g_iBanExpire[i] > iCurrentTime) {
				new szReason[128];
				copy(szReason, charsmax(szReason), g_szBanReason[i]);

				new szKickMsg[256];
				if (g_iBanExpire[i] == 0) {
					formatex(szKickMsg, charsmax(szKickMsg), "你已被永久封禁 (理由: %s)", szReason);
				} else {
					new iRemaining = g_iBanExpire[i] - iCurrentTime;
					new szTime[64];
					format_ban_time(iRemaining, szTime, charsmax(szTime));
					formatex(szKickMsg, charsmax(szKickMsg), "你已被封禁 (剩余: %s, 理由: %s)", szTime, szReason);
				}

				server_cmd("kick #%d ^"%s^"", get_user_userid(id), szKickMsg);
				return;
			} else {
				remove_ban(i);
				i--;
			}
		}
	}
}

remove_ban(index)
{
	if (index < 0 || index >= g_iBanCount) return;

	g_iBanCount--;

	if (index < g_iBanCount) {
		copy(g_szBannedAuth[index], charsmax(g_szBannedAuth[]), g_szBannedAuth[g_iBanCount]);
		g_iBanExpire[index] = g_iBanExpire[g_iBanCount];
		copy(g_szBanReason[index], charsmax(g_szBanReason[]), g_szBanReason[g_iBanCount]);
	}

	g_szBannedAuth[g_iBanCount][0] = '^0';
	g_szBanReason[g_iBanCount][0] = '^0';
	g_iBanExpire[g_iBanCount] = 0;

	save_bans_file();
}

format_ban_time(iSeconds, szBuffer[], iLen)
{
	if (iSeconds <= 0) {
		copy(szBuffer, iLen, "已过期");
		return;
	}

	new iDays = iSeconds / 86400;
	new iHours = (iSeconds % 86400) / 3600;
	new iMins = (iSeconds % 3600) / 60;

	if (iDays > 0) {
		formatex(szBuffer, iLen, "%d天%d小时%d分钟", iDays, iHours, iMins);
	} else if (iHours > 0) {
		formatex(szBuffer, iLen, "%d小时%d分钟", iHours, iMins);
	} else {
		formatex(szBuffer, iLen, "%d分钟", iMins);
	}
}

// 保存封禁列表到 ini 文件
save_bans_file()
{
	new szDir[128];
	get_configsdir(szDir, charsmax(szDir));
	new szFile[256];
	formatex(szFile, charsmax(szFile), "%s/%s", szDir, BAN_FILE);

	new fp = fopen(szFile, "wt");
	if (!fp) return;

	fprintf(fp, "; HNS 封禁名单^n");
	fprintf(fp, "; 格式: authid/ip 过期时间戳 原因^n");
	fprintf(fp, "; 过期时间 0 = 永久^n^n");

	for (new i = 0; i < g_iBanCount; i++) {
		fprintf(fp, "^"%s^" %d ^"%s^"^n", g_szBannedAuth[i], g_iBanExpire[i], g_szBanReason[i]);
	}

	fclose(fp);
}

// 从 ini 文件加载封禁列表
load_bans_file()
{
	new szDir[128];
	get_configsdir(szDir, charsmax(szDir));
	new szFile[256];
	formatex(szFile, charsmax(szFile), "%s/%s", szDir, BAN_FILE);

	new fp = fopen(szFile, "rt");
	if (!fp) return;

	g_iBanCount = 0;

	new szLine[512];
	while (!feof(fp) && g_iBanCount < MAX_BANS) {
		fgets(fp, szLine, charsmax(szLine));
		trim(szLine);

		if (szLine[0] == ';' || szLine[0] == '/' || szLine[0] == '^0') continue;

		new szAuth[64], szReason[128], szExpire[32];
		new iLen = strlen(szLine);

		new iStart = -1, iEnd = -1;
		for (new i = 0; i < iLen; i++) {
			if (szLine[i] == '"') {
				if (iStart == -1) iStart = i + 1;
				else { iEnd = i; break; }
			}
		}

		if (iStart == -1 || iEnd == -1) continue;

		new iAuthLen = iEnd - iStart;
		if (iAuthLen >= charsmax(szAuth)) iAuthLen = charsmax(szAuth) - 1;
		copy(szAuth, iAuthLen, szLine[iStart]);

		new iPos = iEnd + 1;
		while (iPos < iLen && (szLine[iPos] == ' ' || szLine[iPos] == '"')) iPos++;

		new iExpireStart = iPos;
		while (iPos < iLen && szLine[iPos] != ' ' && szLine[iPos] != '"') iPos++;
		new iExpireLen = iPos - iExpireStart;
		if (iExpireLen >= charsmax(szExpire)) iExpireLen = charsmax(szExpire) - 1;
		copy(szExpire, iExpireLen, szLine[iExpireStart]);

		iStart = -1;
		iEnd = -1;
		for (new i = iPos; i < iLen; i++) {
			if (szLine[i] == '"') {
				if (iStart == -1) iStart = i + 1;
				else { iEnd = i; break; }
			}
		}

		if (iStart != -1 && iEnd != -1) {
			new iReasonLen = iEnd - iStart;
			if (iReasonLen >= charsmax(szReason)) iReasonLen = charsmax(szReason) - 1;
			copy(szReason, iReasonLen, szLine[iStart]);
		} else {
			copy(szReason, charsmax(szReason), "未知");
		}

		new iExpire = str_to_num(szExpire);
		if (iExpire != 0 && iExpire < get_systime()) continue;

		copy(g_szBannedAuth[g_iBanCount], charsmax(g_szBannedAuth[]), szAuth);
		g_iBanExpire[g_iBanCount] = iExpire;
		copy(g_szBanReason[g_iBanCount], charsmax(g_szBanReason[]), szReason);
		g_iBanCount++;
	}

	fclose(fp);
}

// ============================================================
//  地图列表加载
// ============================================================
load_map_list()
{
	new szMapCycleFile[64];
	get_cvar_string("mapcyclefile", szMapCycleFile, charsmax(szMapCycleFile));

	new fp = fopen(szMapCycleFile, "rt");
	if (!fp) {
		fp = fopen("mapcycle.txt", "rt");
		if (!fp) return;
	}

	g_iMapCount = 0;
	new szLine[64];

	while (!feof(fp) && g_iMapCount < 256) {
		fgets(fp, szLine, charsmax(szLine));
		trim(szLine);

		if (szLine[0] == ';' || szLine[0] == '/' || szLine[0] == '^0' || strlen(szLine) < 2) continue;

		new szCurrentMap[64];
		get_mapname(szCurrentMap, charsmax(szCurrentMap));

		if (!equal(szLine, szCurrentMap)) {
			copy(g_szMapList[g_iMapCount], charsmax(g_szMapList[]), szLine);
			g_iMapCount++;
		}
	}

	fclose(fp);
}

// ============================================================
//  权限保存/加载 (ini 文件为权威)
// ============================================================

// 从 perm_list.txt (唯一权威) 加载玩家权限
// 硬编码最高服主 (OWNER_AUTH) 免认证, 无需在 txt 登记
stock perm_load(id)
{
	if (g_szAuth[id][0] == '^0') return;

	// 硬编码最高服主: 免认证, 无需在 perm_list.txt 登记, 永远拥有最高服主权限
	if (perm_auth_match(OWNER_AUTH, g_szAuth[id])) {
		g_iPermLevel[id] = PERM_OWNER;
		return;
	}

	// perm_list.txt 为唯一权威认证
	new szDir[128];
	get_configsdir(szDir, charsmax(szDir));
	new szFile[256];
	formatex(szFile, charsmax(szFile), "%s/%s", szDir, PERM_FILE);

	new fp = fopen(szFile, "rt");
	if (!fp) {
		g_iPermLevel[id] = PERM_NONE;
		return;
	}

	new szLine[256];
	new bool:bFound = false;

	while (!feof(fp) && !bFound) {
		fgets(fp, szLine, charsmax(szLine));
		trim(szLine);

		if (szLine[0] == ';' || szLine[0] == '/' || szLine[0] == '^0') continue;

		new szAuth[64], szName[32], szPerm[8];
		parse(szLine, szAuth, charsmax(szAuth), szName, charsmax(szName), szPerm, charsmax(szPerm));

		if (perm_auth_match(szAuth, g_szAuth[id])) {
			new iPerm = str_to_num(szPerm);
			if (iPerm >= PERM_NONE && iPerm <= PERM_OWNER) {
				g_iPermLevel[id] = iPerm;
			}
			bFound = true;
		}
	}

	fclose(fp);

	if (!bFound) {
		g_iPermLevel[id] = PERM_NONE;
	}
}

// 写入 ini 文件 (合并在线玩家 + 保留文件历史)
stock perm_save_file()
{
	new szDir[128];
	get_configsdir(szDir, charsmax(szDir));
	new szFile[256];
	formatex(szFile, charsmax(szFile), "%s/%s", szDir, PERM_FILE);

	// 读取现有文件中的全部历史记录(含离线玩家), 避免覆盖丢失
	new Trie:tExisting = TrieCreate();
	new fp_r = fopen(szFile, "rt");
	if (fp_r) {
		new szLine[256];
		while (!feof(fp_r)) {
			fgets(fp_r, szLine, charsmax(szLine));
			trim(szLine);
			if (szLine[0] == ';' || szLine[0] == '/' || szLine[0] == '^0') continue;

			new szAuth[64], szName[32], szPerm[8];
			parse(szLine, szAuth, charsmax(szAuth), szName, charsmax(szName), szPerm, charsmax(szPerm));
			if (!szAuth[0]) continue;

			if (!TrieKeyExists(tExisting, szAuth)) {
				TrieSetCell(tExisting, szAuth, str_to_num(szPerm));
			}
		}
		fclose(fp_r);
	}

	new fp = fopen(szFile, "wt");
	if (!fp) {
		TrieDestroy(tExisting);
		return;
	}

	fprintf(fp, "; HNS 权限名单^n");
	fprintf(fp, "; 格式: steamid_or_ip 名字 权限等级^n");
	fprintf(fp, "; 等级: 0=普通 2=VIP 3=管理员 4=服主^n");
	fprintf(fp, "; 说明: 本文件为权限唯一权威, 清除即失效^n^n");

	new players[32], num;
	get_players(players, num);

	// 写入在线玩家(内存中的最新权限)
	// 关键: 在线玩家无论是否被清除, 都必须从历史记录中移除旧条目,
	//       否则被清除的玩家会被下方的"离线补写"重新写回成管理员(隔天还在)
	for (new i = 0; i < num; i++) {
		new pid = players[i];
		if (g_szAuth[pid][0] == '^0') continue;

		// 移除该玩家在文件历史中的旧记录
		if (TrieKeyExists(tExisting, g_szAuth[pid])) {
			TrieDeleteKey(tExisting, g_szAuth[pid]);
		}

		// 仅当仍持有纸面权限时才写回
		if (g_iPermLevel[pid] > PERM_NONE) {
			new szName[32];
			get_user_name(pid, szName, charsmax(szName));

			for (new j = 0; j < strlen(szName); j++) {
				if (szName[j] == ' ') szName[j] = '_';
			}

			fprintf(fp, "%s %s %d^n", g_szAuth[pid], szName, g_iPermLevel[pid]);
		}
	}

	// 补写离线玩家(保留其纸面权限)
	new TrieIter:tIter = TrieIterCreate(tExisting);
	new szIterAuth[64], iIterPerm;
	while (!TrieIterEnded(tIter)) {
		TrieIterGetKey(tIter, szIterAuth, charsmax(szIterAuth));
		TrieIterGetCell(tIter, iIterPerm);
		if (iIterPerm > PERM_NONE) {
			fprintf(fp, "%s unknown %d^n", szIterAuth, iIterPerm);
		}
		TrieIterNext(tIter);
	}
	TrieIterDestroy(tIter);
	TrieDestroy(tExisting);

	fclose(fp);
}

// 重置 ini 文件 (清除全部数据)
stock perm_reset_file()
{
	new szDir[128];
	get_configsdir(szDir, charsmax(szDir));
	new szFile[256];
	formatex(szFile, charsmax(szFile), "%s/%s", szDir, PERM_FILE);

	new fp = fopen(szFile, "wt");
	if (!fp) return;

	fprintf(fp, "; HNS 权限名单 (已清除)^n");
	fprintf(fp, "; 格式: steamid_or_ip 名字 权限等级^n");
	fprintf(fp, "; 等级: 0=普通 2=VIP 3=管理员 4=服主^n");
	fprintf(fp, "; 说明: 本文件为权限唯一权威, 清除即失效^n");

	// 同时重置封禁
	new szBanFile[256];
	new szBanDir[128];
	get_configsdir(szBanDir, charsmax(szBanDir));
	formatex(szBanFile, charsmax(szBanFile), "%s/%s", szBanDir, BAN_FILE);

	new fp2 = fopen(szBanFile, "wt");
	if (fp2) {
		fprintf(fp2, "; HNS 封禁名单 (已清除)^n");
		fprintf(fp2, "; 格式: authid/ip 过期时间戳 原因^n");
		fprintf(fp2, "; 过期时间 0 = 永久^n");
		fclose(fp2);
	}

	g_iBanCount = 0;

	fclose(fp);
}