// ============================================================================
// HNS SIGNUP SYSTEM — 完全独立报名插件
// 流程: 报名 → 分组 → 选图(随机/当前) → 直接开始比赛
// 不依赖主插件任何 native 函数, 通过 callfunc 调用主插件公共函数
// 只统计: 比赛开始 / 比赛结束, 其他一切不管
// ============================================================================
#include <amxmodx>
#include <amxmisc>
#include <cstrike>
#include <engine>
#include <fakemeta>
#include <reapi>
// ★ 主插件官方提供的外部开赛接口 (HnsMatchSystem 注册的 native)
//   用于替代原先脆弱的跨插件 callfunc 调用, 保证 AI 报名后能真正开赛
#include <hns_matchsystem>

// ===== 完全独立: 不依赖任何主插件 native 函数 =====
// 开赛时通过 callfunc_begin 调用主插件 cmdStartMatch(0)

#define PLUGIN_NAME  "HNS Signup System"
#define PLUGIN_VER   "1.0.0"
#define PLUGIN_AUTH  "LINNA"

// ---- 状态机 ----
enum SignupState {
	S_IDLE    = 0,
	S_SIGNUP,       // 报名中
	S_READY,        // 已分组, 待选图
	S_STARTING,     // 正在开始/等待比赛缓冲
};

// ---- 玩家数据 ----
enum SignupPlayer {
	SP_SIGNED,          // 是否已报名
	SP_TEAM,            // 本地分组: 0=未分配 / 1=T(A队) / 2=CT(B队)
};

// ---- 恢复数据文件 (随机地图换图用) ----
#define PENDING_FILE "hns_signup_pending.txt"
#define PENDING_FILE_DIR "mixsystem"
#define MAX_MAPS 256

// ---- 任务 ID ----
#define TASK_SIGNUP_TICK  9101
#define TASK_SHOW_MAP     9102
#define TASK_MAP_TIMEOUT  9103
#define TASK_CHANGEMAP    9104
#define TASK_RECOVERY_WAIT 9105
#define TASK_COOLDOWN      9106
#define TASK_ASSIGN_PLAYERS 9107
#define TASK_VOTE_TIMEOUT   9108
#define TASK_VOTE_REFRESH   9109

// ==================== 全局变量 ====================
new SignupState:g_eState = S_IDLE;
new g_plr[MAX_PLAYERS + 1][SignupPlayer];
new g_szAuth[MAX_PLAYERS + 1][35];    // SteamID 或 IP

new g_iSignedCount;            // 已报名人数
new g_iSignupRemaining;        // 报名剩余秒数
new g_iSignupTime;             // 报名总时长
new bool:g_bSponsorMode;       // 本场是否赞助局 (报名前选择)
new bool:g_bNoLimit;           // 报名限制: true=不限制
new g_iChosenStarter;          // 报名/开始发起者 (选图用)

new g_iTeamSize;               // 每队人数
new g_iTotalPlayers;           // 实际参赛人数 (偶数)

// 分组: 按报名顺序交替分配 A/B
new g_szTeamA[MAX_PLAYERS + 1][35];
new g_iTeamACount;
new g_szTeamB[MAX_PLAYERS + 1][35];
new g_iTeamBCount;
new bool:g_bTeamsAssigned;

// 比赛模式选择 (6 个 mix 模式)
new g_iSelectedMode;           // 1=MR, 2=Wintime, 3=Duel, 4=Ascension, 5=Vampire, 6=Rounds
new const g_szModeNames[][] = { "", "MR (最大回合数)", "计时模式", "决斗 (1v1)", "突围模式", "吸血模式", "回合制" };

// 恢复 (随机地图)
new bool:g_bPendingWait;       // 换图后等待玩家连接
new bool:g_bPendingSponsor;
new g_iPendingWaitCount;
new g_iPendingMode;            // 换图恢复: 比赛模式

// 冷却
new bool:g_bCooldown;          // AI 报名冷却中
new g_iCooldownRemaining;      // 冷却剩余秒数

// 逐个分配
new g_iAssignPhase;            // 0=分A队中, 1=分B队中
new g_iAssignIndex;            // 当前分配到第几个

// 模式菜单来源
new bool:g_bModeFromControl;   // true=从控制菜单打开, false=从报名流程打开

// 投票/时间选择
new bool:g_bVoting;            // 投票进行中
new g_iVoteTarget;             // 0=模式投票, 1=时间投票
new g_iVoteChoices[MAX_PLAYERS + 1];
new g_iVoteTimeout;            // 投票剩余秒数
new g_iSelectedTime;           // 选中的比赛时间 (分钟)
new g_iSelectedScore;          // 选中的打满分数 (回合制)
new bool:g_bAdminOnline;       // 是否有管理员在线

// CVar
new g_pSignupTime;
new g_pMinPlayers;

// 菜单 ID
new g_iMenuControl;
new g_iMenuMap;
new g_iMenuMode;

// HUD
new g_iHudSync;

// ==================== 初始化 ====================
public plugin_init() {
	register_plugin(PLUGIN_NAME, PLUGIN_VER, PLUGIN_AUTH);

	g_pSignupTime = register_cvar("hns_signup_time", "60");
	g_pMinPlayers = register_cvar("hns_signup_min_players", "2");

	// 分队上限: 默认 5v5, 实际按报名时在线可参赛人数自动取最大偶数分队 (上限之内)
	g_iTeamSize = 5;

	g_iMenuControl = register_menuid("SignupControlMenu");
	g_iMenuMap     = register_menuid("SignupMapMenu");
	g_iMenuMode    = register_menuid("SignupModeMenu");
	register_menucmd(g_iMenuControl, 1023, "handleControlMenu");
	register_menucmd(g_iMenuMap,     1023, "handleMapMenu");
	register_menucmd(g_iMenuMode,    1023, "handleModeMenu");

	register_menuid("SignupTimeMenu");
	register_menucmd(register_menuid("SignupVoteMenu"), 1023, "handleVoteMenu");
	register_menucmd(register_menuid("SignupTimeMenu"), 1023, "handleTimeMenu");
	register_menuid("SignupScoreMenu");
	register_menucmd(register_menuid("SignupScoreMenu"), 1023, "handleScoreMenu");

	g_iHudSync = CreateHudSyncObj();

	// 命令
	register_clcmd("say /ai",       "cmdSignupMenu");
	register_clcmd("say_team /ai",  "cmdSignupMenu");
	register_clcmd("say /join",      "cmdJoin");
	register_clcmd("say_team /join", "cmdJoin");
	register_clcmd("say /unjoin",    "cmdUnjoin");
	register_clcmd("say_team /unjoin", "cmdUnjoin");
	register_clcmd("say /teams",     "cmdShowTeams");
	register_clcmd("say_team /teams","cmdShowTeams");

	// 报名冷却 HUD 刷新
	remove_task(TASK_SIGNUP_TICK);
	set_task(1.0, "taskSignupTick", TASK_SIGNUP_TICK, _, _, "b");
}

public plugin_cfg() {
	// 若是随机地图后换图归来, 恢复分组并自动开赛
	checkRecovery();
}

// ==================== 判断管理员/观察者 ====================
stock bool:isControllable(id) {
	if (id == 0) return true;             // 服务器控制台
	if (get_user_flags(id) & read_flags("f")) return true;  // HNS watcher flag
	if (is_user_admin(id)) return true;
	return false;
}

// ==================== 菜单入口 ====================
public cmdSignupMenu(id) {
	if (!isControllable(id)) {
		if (g_eState == S_SIGNUP) {
			// 显示已报名玩家列表
			new szMsg[256], iLen, iCount;
			iLen = formatex(szMsg, charsmax(szMsg), "[报名] 已报名玩家 (%d/%d):", g_iSignedCount, g_iTeamSize * 2);
			for (new i = 1; i <= MAX_PLAYERS; i++) {
				if (!g_plr[i][SP_SIGNED] || !is_user_connected(i)) continue;
				new szName[32]; get_user_name(i, szName, charsmax(szName));
				iLen += formatex(szMsg[iLen], charsmax(szMsg) - iLen, "^n  %d. %s", iCount + 1, szName);
				iCount++;
			}
			client_print(id, print_chat, szMsg);
			client_print(id, print_chat, "[报名] 请输入 /join 报名, /unjoin 取消报名。");
		} else if (g_eState == S_READY) {
			client_print(id, print_chat, "[报名] 分组已完成, 等待比赛开始。");
		} else if (g_bCooldown) {
			client_print(id, print_chat, "[报名] AI 报名冷却中, 剩余 %d 秒。", g_iCooldownRemaining);
		} else {
			client_print(id, print_chat, "[报名] 当前暂无报名, 等待管理开始。");
		}
		return PLUGIN_HANDLED;
	}
	showControlMenu(id);
	return PLUGIN_HANDLED;
}

// ---- 比赛模式选择菜单 (6 个 mix 模式) ----
showModeMenu(id) {
	new szMenu[512], len;
	len  = formatex(szMenu, charsmax(szMenu), "\r选择比赛模式^n^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r当前: %s^n^n", g_szModeNames[g_iSelectedMode]);
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r1.\w MR (最大回合数)^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r2.\w 计时模式^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r3.\w 决斗 (1v1)^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r4.\w 突围模式^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r5.\w 吸血模式^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r6.\w 回合制^n^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r0.\w 返回");

	show_menu(id, (1<<0)|(1<<1)|(1<<2)|(1<<3)|(1<<4)|(1<<5)|(1<<9), szMenu, -1, "SignupModeMenu");
}

public handleModeMenu(id, key) {
	if (!isControllable(id)) return PLUGIN_HANDLED;

	switch (key) {
		case 0..5: { // 1-6: 选择模式 → 留在菜单, 按0继续
			new iMode = key + 1;
			g_iSelectedMode = iMode;
			client_print(id, print_chat, "[报名] 比赛模式已设为: %s, 按 0 继续下一步。", g_szModeNames[iMode]);
			showModeMenu(id);
		}
		case 9: { // 0 → 下一步
			remove_task(TASK_MAP_TIMEOUT);
			if (g_bModeFromControl) {
				g_bModeFromControl = false;
				showControlMenu(id);
			} else if (g_iSelectedMode == 2) {
				// 计时模式: 进入时间选择
				showTimeMenuTo(id);
			} else if (g_iSelectedMode == 6) {
				// 回合制: 进入打满分数选择
				showScoreMenuTo(id);
			} else {
				// 其他模式: 直接进入选图, 不需要时间选择
				remove_task(TASK_MAP_TIMEOUT);
				taskShowMapMenu();
			}
		}
	}
	return PLUGIN_HANDLED;
}

// ---- 报名控制菜单 (仿 "报名分组" 样式) ----
showControlMenu(id) {
	new bool:bAdmin = isControllable(id);
	new szMenu[512], len;
	new iKeys = (1<<0)|(1<<1)|(1<<2)|(1<<9);

	len  = formatex(szMenu, charsmax(szMenu), "\r报名分组^n^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r1.\w 报名 (%d/%d)^n", g_iSignedCount, g_bNoLimit ? 32 : g_iTeamSize * 2);
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r2.\w 取消^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r3.\w 查看分组^n^n");

	if (bAdmin) {
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r4.\w 智能分组^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r5.\w 强制开始 \d(测试)^n^n");

		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r6.\w 报名限制: %s^n", g_bNoLimit ? "\y不限制" : "\w限制");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r7.\w 比赛模式: %s^n", g_szModeNames[g_iSelectedMode]);
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r8.\w 本场类型: %s^n^n", g_bSponsorMode ? "\y赞助局" : "\w娱乐局");

		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r9.\w 报名重置^n^n");

		iKeys |= (1<<3)|(1<<4)|(1<<5)|(1<<6)|(1<<7)|(1<<8);
	}

	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r0.\w 退出");

	show_menu(id, iKeys, szMenu, -1, "SignupControlMenu");
}

public handleControlMenu(id, key) {
	switch (key) {
		case 0: { // 1. 报名
			cmdJoin(id);
		}
		case 1: { // 2. 取消
			if (g_plr[id][SP_SIGNED]) unjoinPlayer(id);
			else client_print(id, print_chat, "[报名] 你当前未报名。");
		}
		case 2: { // 3. 查看分组
			if (g_bTeamsAssigned) showTeamsTo(id);
			else client_print(id, print_chat, "[报名] 还未分组。");
		}
		case 3: { // 4. 智能分组 (管理)
			if (!isControllable(id)) return PLUGIN_HANDLED;
			if (g_bTeamsAssigned) {
				assignTeams();
				client_print(0, print_chat, "[报名] 已重新智能分组!");
			} else {
				client_print(id, print_chat, "[报名] 还没有分组, 请先报名。");
			}
		}
		case 4: { // 5. 强制开始 (管理测试)
			if (!isControllable(id)) return PLUGIN_HANDLED;
			if (g_eState == S_STARTING) {
				client_print(id, print_chat, "[报名] 比赛正在开始。");
			} else {
				if (g_eState != S_SIGNUP) signupStart(id);
				if (!g_plr[id][SP_SIGNED]) {
					g_plr[id][SP_SIGNED] = true;
					g_plr[id][SP_TEAM] = 0;
					new szAuth[35];
					getPlayerAuth(id, szAuth, charsmax(szAuth));
					copy(g_szAuth[id], 34, szAuth);
					g_iSignedCount++;
					client_print(0, print_chat, "[报名] 测试: %n 已自动加入。", id);
				}
				client_print(0, print_chat, "[报名] 管理 %n 强制开始比赛 (测试)。", id);
				signupEnd(id, true);
			}
		}
		case 5: { // 6. 报名限制 (管理)
			if (!isControllable(id)) return PLUGIN_HANDLED;
			g_bNoLimit = !g_bNoLimit;
			client_print(0, print_chat, "[报名] 报名限制: %s", g_bNoLimit ? "不限制" : "限制");
		}
		case 6: { // 7. 比赛模式 (管理)
			if (!isControllable(id)) return PLUGIN_HANDLED;
			if (g_eState == S_SIGNUP || g_eState == S_READY || g_eState == S_IDLE) {
				g_bModeFromControl = true;
				showModeMenu(id);
			} else
				client_print(id, print_chat, "[报名] 比赛正在开始, 无法修改模式。");
		}
		case 7: { // 8. 本场类型 (管理)
			if (!isControllable(id)) return PLUGIN_HANDLED;
			g_bSponsorMode = !g_bSponsorMode;
			client_print(0, print_chat, "[报名] 本场类型切换为 %s。", g_bSponsorMode ? "赞助局" : "娱乐局");
		}
		case 8: { // 9. 报名重置 (管理)
			if (!isControllable(id)) return PLUGIN_HANDLED;
			signupCancel(id);
		}
		case 9:
			return PLUGIN_HANDLED;
	}

	showControlMenu(id);
	return PLUGIN_HANDLED;
}

// ==================== 报名 ====================
stock signupStart(id) {
	#pragma unused id

	// 检查冷却
	if (g_bCooldown) {
		client_print(id, print_chat, "[报名] AI 报名冷却中, 剩余 %d 秒。", g_iCooldownRemaining);
		return;
	}

	g_eState = S_SIGNUP;
	g_iSignedCount = 0;
	g_iTeamSize = 5;
	g_iSignupTime = get_pcvar_num(g_pSignupTime);
	g_iSignupRemaining = g_iSignupTime;
	g_bTeamsAssigned = false;
	g_iSelectedMode = 1;  // 默认 MR
	g_iSelectedScore = 0;
	g_iTeamACount = 0;
	g_iTeamBCount = 0;
	for (new i = 1; i <= MAX_PLAYERS; i++) {
		g_plr[i][SP_SIGNED] = false;
		g_plr[i][SP_TEAM] = 0;
		g_szAuth[i][0] = EOS;
	}

	client_print(0, print_chat, "^2[HNS] ^1报名开始! 输入 /join 报名 (%d 秒)", g_iSignupTime);
	client_print(0, print_chat, "^2[HNS] ^1最高 10 人, 最低 2 人, 自动平分队伍, 本场类型: %s", g_bSponsorMode ? "赞助局" : "娱乐局");
}

public cmdJoin(id) {
	if (g_eState == S_STARTING)      { client_print(id, print_chat, "[报名] 比赛正在开始。"); return PLUGIN_HANDLED; }
	if (g_eState == S_READY)         { client_print(id, print_chat, "[报名] 已分组完毕。");   return PLUGIN_HANDLED; }
	if (g_bCooldown)                 { client_print(id, print_chat, "[报名] AI 报名冷却中, 剩余 %d 秒。", g_iCooldownRemaining); return PLUGIN_HANDLED; }

	// 报名中 切换取消
	if (g_plr[id][SP_SIGNED]) {
		unjoinPlayer(id);
		return PLUGIN_HANDLED;
	}

	// 未在报名中: 仅管理可开启报名
	if (g_eState != S_SIGNUP) {
		if (!isControllable(id)) {
			client_print(id, print_chat, "[报名] 报名尚未开始, 请等待管理开启。");
			return PLUGIN_HANDLED;
		}
		signupStart(id);
	}

	new iMax = g_bNoLimit ? 32 : g_iTeamSize * 2;
	if (g_iSignedCount >= iMax) {
		client_print(id, print_chat, "[报名] 报名已满 (%d/%d)。", g_iSignedCount, iMax);
		return PLUGIN_HANDLED;
	}

	g_plr[id][SP_SIGNED] = true;
	g_plr[id][SP_TEAM] = 0;
	new szAuth[35];
	getPlayerAuth(id, szAuth, charsmax(szAuth));
	copy(g_szAuth[id], 34, szAuth);
	g_iSignedCount++;

	new szName[32]; get_user_name(id, szName, charsmax(szName));
	// 报名公告: [HNS] 绿色 + 当前报名人数 白色 + 请各位玩家尽快报名
	client_print(0, print_chat, "^2[HNS] ^1%n 报名了! 当前报名人数: %d, 请各位玩家尽快报名", id, g_iSignedCount);

	if (g_iSignedCount >= iMax) {
		client_print(0, print_chat, "[报名] 报名已满, 立即分组...");
		signupEnd(id, false);
	}
	return PLUGIN_HANDLED;
}

public cmdUnjoin(id) {
	if (g_plr[id][SP_SIGNED]) unjoinPlayer(id);
	else client_print(id, print_chat, "[报名] 你当前未报名。");
	return PLUGIN_HANDLED;
}

stock unjoinPlayer(id) {
	if (!g_plr[id][SP_SIGNED]) return;
	g_plr[id][SP_SIGNED] = false;
	g_plr[id][SP_TEAM] = 0;
	g_iSignedCount--;
	if (g_iSignedCount < 0) g_iSignedCount = 0;

	new szName[32]; get_user_name(id, szName, charsmax(szName));
	client_print(0, print_chat, "[报名] %s 取消了报名。(已报名: %d)", szName, g_iSignedCount);

	if (g_iSignedCount <= 0) signupCancel(0);
}

// ==================== 报名倒计时 ====================
public taskSignupTick() {
	// 冷却中: 显示冷却 HUD
	if (g_bCooldown) {
		g_iCooldownRemaining--;
		if (g_iCooldownRemaining <= 0) {
			g_bCooldown = false;
			remove_task(TASK_COOLDOWN);
			client_print(0, print_chat, "[报名] AI 报名冷却已结束, 可以开始报名。");
		} else {
			set_hudmessage(255, 100, 0, -1.0, 0.20, 0, 0.0, 1.0, 0.0, 0.0);
			ShowSyncHudMsg(0, g_iHudSync, "AI 报名冷却中...^n剩余 %d 秒", g_iCooldownRemaining);
		}
		return;
	}

	if (g_eState != S_SIGNUP) {
		if (g_eState == S_READY && g_bTeamsAssigned)
			showTeamsHud();
		return;
	}

	g_iSignupRemaining--;
	if (g_iSignupRemaining <= 0) {
		signupEnd(0, false);
		return;
	}

	if (g_iSignupRemaining <= 10 && g_iSignupRemaining > 0)
		client_print(0, print_chat, "[报名] 最后 %d 秒! 已报名: %d", g_iSignupRemaining, g_iSignedCount);

	// 显示已报名玩家列表
	new szHud[1024], iLen, iCount;
	new iMax = g_bNoLimit ? 32 : g_iTeamSize * 2;
	iLen = formatex(szHud, charsmax(szHud), "报名分组 | 已报名: %d/%d | 剩余: %d秒^n", g_iSignedCount, iMax, g_iSignupRemaining);
	iLen += formatex(szHud[iLen], charsmax(szHud) - iLen, "输入 /join 报名 /unjoin 取消^n^n");

	for (new i = 1; i <= MAX_PLAYERS; i++) {
		if (!g_plr[i][SP_SIGNED] || !is_user_connected(i)) continue;
		new szName[32]; get_user_name(i, szName, charsmax(szName));
		iLen += formatex(szHud[iLen], charsmax(szHud) - iLen, "%d. %s  ", iCount + 1, szName);
		iCount++;
		if (iCount % 3 == 0) iLen += formatex(szHud[iLen], charsmax(szHud) - iLen, "^n");
	}

	if (iCount == 0)
		iLen += formatex(szHud[iLen], charsmax(szHud) - iLen, "暂无玩家报名");

	set_hudmessage(255, 255, 0, -1.0, 0.12, 0, 0.0, 1.0, 0.0, 0.0);
	ShowSyncHudMsg(0, g_iHudSync, szHud);
}

stock getOnlineCount() {
	new iPlayers[MAX_PLAYERS], iNum;
	get_players(iPlayers, iNum, "ch");
	return iNum;
}

// ==================== 结束报名 → 分组 ====================
stock signupEnd(id, bool:bForced) {
	if (g_eState != S_SIGNUP) return;
	g_eState = S_READY;

	new iMin = get_pcvar_num(g_pMinPlayers);

	// 强制开赛 (管理员测试): 忽略人数下限, 允许 1 人 (1v0) 直接开
	if (g_iSignedCount < (bForced ? 1 : iMin)) {
		client_print(0, print_chat, "[报名] 报名人数不足 (%d < %d), 已取消。", g_iSignedCount, bForced ? 1 : iMin);
		signupCancel(0);
		return;
	}

	// 参赛人数上限 10 人, 下限 2 人, 奇数自动排除一人
	g_iTotalPlayers = g_iSignedCount;
	if (!bForced && g_iTotalPlayers > 10) g_iTotalPlayers = 10;
	if (!bForced && (g_iTotalPlayers % 2 != 0)) g_iTotalPlayers--;
	if (!bForced && g_iTotalPlayers < 2) {
		client_print(0, print_chat, "[报名] 有效人数不足 2 人, 已取消。");
		signupCancel(0);
		return;
	}
	if (g_iTotalPlayers < 1) g_iTotalPlayers = 1;

	// 根据总人数自动设置每队上限 (平分)
	g_iTeamSize = g_iTotalPlayers / 2;

	assignTeams();

	client_print(0, print_chat, "[报名] 报名结束! %d 人参加, %dv%d, 模式: %s%s", g_iTotalPlayers, g_iTeamACount, g_iTeamBCount, g_szModeNames[g_iSelectedMode], bForced ? " (测试)" : "");
	client_print(0, print_chat, "[报名] 本场类型: %s", g_bSponsorMode ? "赞助局" : "娱乐局");

	// 延迟后进入选模式 (让玩家看到分组)
	g_iChosenStarter = id;
	remove_task(TASK_SHOW_MAP);
	set_task(2.0, "taskShowModeMenu", TASK_SHOW_MAP);
}

// ---- 获取稳定身份 (SteamID 或 IP) ----
stock getPlayerAuth(id, szOut[], iLen) {
	if (!get_user_authid(id, szOut, iLen) || equal(szOut, "STEAM_ID_PENDING") || equal(szOut, "STEAM_ID_LAN"))
		get_user_ip(id, szOut, iLen, 1);
}

stock findIdByAuth(const szAuth[]) {
	for (new i = 1; i <= MAX_PLAYERS; i++) {
		if (!is_user_connected(i)) continue;
		new szA[35];
		getPlayerAuth(i, szA, charsmax(szA));
		if (equali(szA, szAuth)) return i;
	}
	return 0;
}

stock nameByAuth(const szAuth[], szName[], iLen) {
	copy(szName, iLen, "<离线>");
	new id = findIdByAuth(szAuth);
	if (id > 0) get_user_name(id, szName, iLen);
}

// ---- 随机分组 (Fisher-Yates 打乱后交替) ----
stock assignTeams() {
	g_iTeamACount = 0;
	g_iTeamBCount = 0;

	// 收集已报名且有效的玩家 auth
	new szOrder[MAX_PLAYERS + 1][35], iOrder;
	for (new i = 1; i <= MAX_PLAYERS; i++) {
		if (g_plr[i][SP_SIGNED] && g_szAuth[i][0]) {
			copy(szOrder[iOrder], 34, g_szAuth[i]);
			iOrder++;
		}
	}

	// 限制到实际参赛人数
	if (iOrder > g_iTotalPlayers) iOrder = g_iTotalPlayers;

	// ★ Fisher-Yates 随机打乱 (确保每次分配不一样)
	for (new i = iOrder - 1; i > 0; i--) {
		new j = random(i + 1);
		new szTmp[35];
		copy(szTmp, 34, szOrder[i]);
		copy(szOrder[i], 34, szOrder[j]);
		copy(szOrder[j], 34, szTmp);
	}

	// 打乱后交替分配
	new bool:bTeamA = (random_num(0, 1) == 0);
	for (new i = 0; i < iOrder; i++) {
		if (bTeamA) {
			copy(g_szTeamA[g_iTeamACount], 34, szOrder[i]);
			g_iTeamACount++;
		} else {
			copy(g_szTeamB[g_iTeamBCount], 34, szOrder[i]);
			g_iTeamBCount++;
		}
		bTeamA = !bTeamA;
	}

	g_bTeamsAssigned = true;

	client_print(0, print_chat, "[报名] ======== 分组结果 ========");
	client_print(0, print_chat, "[报名] A队(T方) %d人 | B队(CT方) %d人", g_iTeamACount, g_iTeamBCount);
}

// 队伍 HUD 显示 (READY 阶段)
stock showTeamsHud() {
	new szMsg[512], len;
	len = formatex(szMsg, charsmax(szMsg), "== 分组结果 ==^n");

	len += formatex(szMsg[len], charsmax(szMsg) - len, "^n[T - A队] (%d):", g_iTeamACount);
	for (new i = 0; i < g_iTeamACount; i++) {
		new szN[32]; nameByAuth(g_szTeamA[i], szN, charsmax(szN));
		len += formatex(szMsg[len], charsmax(szMsg) - len, "^n  %d. %s", i + 1, szN);
	}

	len += formatex(szMsg[len], charsmax(szMsg) - len, "^n^n[CT - B队] (%d):", g_iTeamBCount);
	for (new i = 0; i < g_iTeamBCount; i++) {
		new szN[32]; nameByAuth(g_szTeamB[i], szN, charsmax(szN));
		len += formatex(szMsg[len], charsmax(szMsg) - len, "^n  %d. %s", i + 1, szN);
	}

	set_hudmessage(100, 255, 100, -1.0, 0.15, 0, 0.0, 3.0, 0.0, 0.0);
	ShowSyncHudMsg(0, g_iHudSync, szMsg);
}

// ==================== 选模式 ====================
public taskShowModeMenu() {
	if (g_eState != S_READY) return;

	// 检测是否有管理员在线
	g_bAdminOnline = (get_any_controller() > 0);

	if (g_bAdminOnline) {
		// ★ 管理员在线: 管理员直接选择模式, 选完后按0进入时间选择
		new iAdmin = get_any_controller();
		g_iChosenStarter = iAdmin;
		client_print(0, print_chat, "^2[HNS] ^1请 %N 选择比赛模式, 选好后按 0 继续。", iAdmin);
		showModeMenu(iAdmin);
	} else {
		// ★ 管理员不在线: 全服玩家投票选模式
		startModeVote();
	}
}

// ==================== 管理员选时间 ====================
// 传入玩家 ID, 直接给该玩家显示时间菜单, 不再重新搜索管理员
stock showTimeMenuTo(id) {
	if (g_eState != S_READY) return;

	if (!is_user_connected(id)) {
		// 玩家突然掉线, 默认 20 分钟
		g_iSelectedTime = 20;
		client_print(0, print_chat, "[报名] 发起者已离线, 默认比赛时间: 20 分钟");
		taskShowMapMenu();
		return;
	}

	showTimeMenu(id);
}

showTimeMenu(id) {
	new szMenu[512], len;
	len  = formatex(szMenu, charsmax(szMenu), "\r选择比赛时间^n^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r当前模式: %s^n^n", g_szModeNames[g_iSelectedMode]);
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r1.\w 10 分钟^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r2.\w 15 分钟^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r3.\w 20 分钟^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r4.\w 25 分钟^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r5.\w 30 分钟^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r6.\w 45 分钟^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r7.\w 60 分钟^n^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r0.\w 返回");

	show_menu(id, (1<<0)|(1<<1)|(1<<2)|(1<<3)|(1<<4)|(1<<5)|(1<<6)|(1<<9), szMenu, -1, "SignupTimeMenu");
}

public handleTimeMenu(id, key) {
	if (!isControllable(id)) return PLUGIN_HANDLED;
	remove_task(TASK_MAP_TIMEOUT);

	switch (key) {
		case 0..6: { // 1-7: 选择时间
			new iTimeOptions[] = { 10, 15, 20, 25, 30, 45, 60 };
			g_iSelectedTime = iTimeOptions[key];
			client_print(0, print_chat, "[报名] 比赛时间已设为: %d 分钟", g_iSelectedTime);
			client_print(0, print_chat, "^2[HNS] ^1比赛配置: %s | T: %d 分钟", g_szModeNames[g_iSelectedMode], g_iSelectedTime);
			remove_task(TASK_MAP_TIMEOUT);
			taskShowMapMenu();
		}
		case 9: { // 返回 → 重新选模式
			showModeMenu(id);
		}
	}
	return PLUGIN_HANDLED;
}

