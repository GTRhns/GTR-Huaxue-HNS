// ==================== 玩家投票系统 ====================
stock startModeVote() {
	g_bVoting = true;
	g_iVoteTarget = 0;
	g_iVoteTimeout = 15;
	for (new i = 1; i <= MAX_PLAYERS; i++) g_iVoteChoices[i] = 0;

	client_print(0, print_chat, "^2[HNS] ^1管理员不在线, 由玩家投票选择比赛模式 (15秒)");
	showVoteMenuAll();

	remove_task(TASK_VOTE_TIMEOUT);
	set_task(1.0, "taskVoteTimeout", TASK_VOTE_TIMEOUT, _, _, "b");
}

stock startTimeVote() {
	g_bVoting = true;
	g_iVoteTarget = 1;
	g_iVoteTimeout = 15;
	for (new i = 1; i <= MAX_PLAYERS; i++) g_iVoteChoices[i] = 0;

	client_print(0, print_chat, "^2[HNS] ^1现在投票选择比赛时间 (15秒)");
	showVoteMenuAll();

	remove_task(TASK_VOTE_TIMEOUT);
	set_task(1.0, "taskVoteTimeout", TASK_VOTE_TIMEOUT, _, _, "b");
}

stock startScoreVote() {
	g_bVoting = true;
	g_iVoteTarget = 2;
	g_iVoteTimeout = 15;
	for (new i = 1; i <= MAX_PLAYERS; i++) g_iVoteChoices[i] = 0;

	client_print(0, print_chat, "^2[HNS] ^1现在投票选择打满分数 (15秒)");
	showVoteMenuAll();

	remove_task(TASK_VOTE_TIMEOUT);
	set_task(1.0, "taskVoteTimeout", TASK_VOTE_TIMEOUT, _, _, "b");
}

stock showVoteMenuAll() {
	new szMenu[512], len;

	if (g_iVoteTarget == 0) {
		// 模式投票
		len  = formatex(szMenu, charsmax(szMenu), "\r投票选择比赛模式^n^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r剩余 \y%d\w 秒^n^n", g_iVoteTimeout);
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r1.\w MR (最大回合数)^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r2.\w 计时模式^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r3.\w 决斗 (1v1)^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r4.\w 突围模式^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r5.\w 吸血模式^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r6.\w 回合制^n^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r0.\w 弃权");
	} else if (g_iVoteTarget == 1) {
		// 时间投票
		len  = formatex(szMenu, charsmax(szMenu), "\r投票选择比赛时间^n^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r当前模式: %s^n", g_szModeNames[g_iSelectedMode]);
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r剩余 \y%d\w 秒^n^n", g_iVoteTimeout);
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r1.\w 10 分钟^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r2.\w 15 分钟^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r3.\w 20 分钟^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r4.\w 25 分钟^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r5.\w 30 分钟^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r6.\w 45 分钟^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r7.\w 60 分钟^n^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r0.\w 弃权");
	} else {
		// 打满分数投票 (回合制)
		len  = formatex(szMenu, charsmax(szMenu), "\r投票选择打满分数^n^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r当前模式: %s^n", g_szModeNames[g_iSelectedMode]);
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r剩余 \y%d\w 秒^n^n", g_iVoteTimeout);
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r1.\w 5 分^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r2.\w 6 分^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r3.\w 7 分^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r4.\w 8 分^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r5.\w 9 分^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r6.\w 10 分^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r7.\w 11 分^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r8.\w 12 分^n^n");
		len += formatex(szMenu[len], charsmax(szMenu) - len, "\r0.\w 弃权");
	}

	// 显示给所有在线玩家
	new iPlayers[MAX_PLAYERS], iNum;
	get_players(iPlayers, iNum, "ch");
	for (new i = 0; i < iNum; i++) {
		show_menu(iPlayers[i], (1<<0)|(1<<1)|(1<<2)|(1<<3)|(1<<4)|(1<<5)|(1<<6)|(1<<7)|(1<<9), szMenu, -1, "SignupVoteMenu");
	}
}

public handleVoteMenu(id, key) {
	if (!g_bVoting) return PLUGIN_HANDLED;

	if (key == 9) {
		g_iVoteChoices[id] = 0;  // 弃权
	} else {
		g_iVoteChoices[id] = key + 1;
	}
	return PLUGIN_HANDLED;
}

public taskVoteTimeout() {
	if (!g_bVoting) { remove_task(TASK_VOTE_TIMEOUT); return; }

	g_iVoteTimeout--;

	// HUD 显示当前票数
	new szHud[512], len;
	if (g_iVoteTarget == 0) {
		len = formatex(szHud, charsmax(szHud), "投票: 选择比赛模式^n剩余 \y%d\w 秒^n^n", g_iVoteTimeout);
		new iCounts[7];
		for (new i = 1; i <= MAX_PLAYERS; i++) {
			if (g_iVoteChoices[i] > 0 && g_iVoteChoices[i] <= 6)
				iCounts[g_iVoteChoices[i]]++;
		}
		for (new i = 1; i <= 6; i++) {
			len += formatex(szHud[len], charsmax(szHud) - len, "\r%d. \w%s: \y%d票^n", i, g_szModeNames[i], iCounts[i]);
		}
	} else if (g_iVoteTarget == 1) {
		len = formatex(szHud, charsmax(szHud), "投票: 选择比赛时间^n剩余 \y%d\w 秒^n^n", g_iVoteTimeout);
		new iCounts[8];
		for (new i = 1; i <= MAX_PLAYERS; i++) {
			if (g_iVoteChoices[i] > 0 && g_iVoteChoices[i] <= 7)
				iCounts[g_iVoteChoices[i]]++;
		}
		new const szTimeLabels[][] = { "", "10 分钟", "15 分钟", "20 分钟", "25 分钟", "30 分钟", "45 分钟", "60 分钟" };
		for (new i = 1; i <= 7; i++) {
			len += formatex(szHud[len], charsmax(szHud) - len, "\r%d. \w%s: \y%d票^n", i, szTimeLabels[i], iCounts[i]);
		}
	} else {
		len = formatex(szHud, charsmax(szHud), "投票: 选择打满分数^n剩余 \y%d\w 秒^n^n", g_iVoteTimeout);
		new iCounts[9];
		for (new i = 1; i <= MAX_PLAYERS; i++) {
			if (g_iVoteChoices[i] > 0 && g_iVoteChoices[i] <= 8)
				iCounts[g_iVoteChoices[i]]++;
		}
		new const szScoreLabels[][] = { "", "5 分", "6 分", "7 分", "8 分", "9 分", "10 分", "11 分", "12 分" };
		for (new i = 1; i <= 8; i++) {
			len += formatex(szHud[len], charsmax(szHud) - len, "\r%d. \w%s: \y%d票^n", i, szScoreLabels[i], iCounts[i]);
		}
	}

	set_hudmessage(0, 200, 255, -1.0, 0.10, 0, 0.0, 1.0, 0.0, 0.0);
	ShowSyncHudMsg(0, g_iHudSync, szHud);

	// 刷新投票菜单 (让玩家看到最新票数并可改票)
	showVoteMenuAll();

	if (g_iVoteTimeout <= 0) {
		g_bVoting = false;
		remove_task(TASK_VOTE_TIMEOUT);

		new iWinner = tallyVote();

		if (g_iVoteTarget == 0) {
			if (iWinner < 1 || iWinner > 6) iWinner = 1;
			g_iSelectedMode = iWinner;
			client_print(0, print_chat, "^2[HNS] ^1投票结果: 比赛模式 = \y%s", g_szModeNames[iWinner]);
			remove_task(TASK_VOTE_TIMEOUT);
			// 不同模式进入对应设置: 计时→时间投票, 回合制→打满分数投票, 其他→选图
			if (iWinner == 2) {
				set_task(1.5, "startTimeVote", TASK_VOTE_TIMEOUT);
			} else if (iWinner == 6) {
				set_task(1.5, "startScoreVote", TASK_VOTE_TIMEOUT);
			} else {
				set_task(1.5, "taskShowMapMenu", TASK_VOTE_TIMEOUT);
			}
		} else if (g_iVoteTarget == 1) {
			new const szTimeVals[] = { 0, 10, 15, 20, 25, 30, 45, 60 };
			if (iWinner < 1 || iWinner > 7) iWinner = 3;
			g_iSelectedTime = szTimeVals[iWinner];
			client_print(0, print_chat, "^2[HNS] ^1投票结果: 比赛时间 = \y%d 分钟", g_iSelectedTime);
			client_print(0, print_chat, "^2[HNS] ^1比赛配置: %s | T: %d 分钟", g_szModeNames[g_iSelectedMode], g_iSelectedTime);
			// 1.5 秒后进入选图
			remove_task(TASK_VOTE_TIMEOUT);
			set_task(1.5, "taskShowMapMenu", TASK_VOTE_TIMEOUT);
		} else if (g_iVoteTarget == 2) {
			new const iScoreVals[] = { 0, 5, 6, 7, 8, 9, 10, 11, 12 };
			if (iWinner < 1 || iWinner > 8) iWinner = 6;
			g_iSelectedScore = iScoreVals[iWinner];
			client_print(0, print_chat, "^2[HNS] ^1投票结果: 打满分数 = \y%d 分", g_iSelectedScore);
			client_print(0, print_chat, "^2[HNS] ^1比赛配置: %s | 打满: %d 分", g_szModeNames[g_iSelectedMode], g_iSelectedScore);
			// 1.5 秒后进入选图
			remove_task(TASK_VOTE_TIMEOUT);
			set_task(1.5, "taskShowMapMenu", TASK_VOTE_TIMEOUT);
		}
	}
}

stock tallyVote() {
	new iCounts[10];
	for (new i = 1; i <= MAX_PLAYERS; i++) {
		if (g_iVoteChoices[i] > 0 && g_iVoteChoices[i] < 10)
			iCounts[g_iVoteChoices[i]]++;
	}

	new iWinner = 1, iMax = 0;
	for (new i = 1; i < 10; i++) {
		if (iCounts[i] > iMax) {
			iMax = iCounts[i];
			iWinner = i;
		}
	}
	return iWinner;
}

// ==================== 选图 ====================
public taskShowMapMenu() {
	if (g_eState != S_READY) return;

	new iMenuTarget = g_iChosenStarter;
	if (iMenuTarget <= 0 || !is_user_connected(iMenuTarget))
		iMenuTarget = get_any_controller();

	if (iMenuTarget <= 0) {
		// 无人在线管理, 默认当前地图开赛
		beginCurrentMapMatch();
		return;
	}

	new szMenu[512], len;
	len  = formatex(szMenu, charsmax(szMenu), "\r选择比赛地图^n^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r参赛: %dv%d | 类型: %s^n^n", g_iTeamACount, g_iTeamBCount, g_bSponsorMode ? "赞助局" : "娱乐局");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r1.\w 当前地图 (直接开赛)^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r2.\w 随机地图^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r3.\w 指定地图 (打开地图列表)^n^n");
	len += formatex(szMenu[len], charsmax(szMenu) - len, "\r0.\w 退出");

	show_menu(iMenuTarget, (1<<0)|(1<<1)|(1<<2)|(1<<9), szMenu, -1, "SignupMapMenu");

	// 超时 15 秒默认当前地图
	remove_task(TASK_MAP_TIMEOUT);
	set_task(15.0, "taskMapTimeout", TASK_MAP_TIMEOUT);
}

public taskMapTimeout() {
	if (g_eState == S_READY) beginCurrentMapMatch();
}

public handleMapMenu(id, key) {
	remove_task(TASK_MAP_TIMEOUT);
	g_iChosenStarter = id;

	if (g_eState != S_READY) return PLUGIN_HANDLED;

	switch (key) {
		case 0: beginCurrentMapMatch();
		case 1: beginRandomMapMatch(id);
		case 2: beginSpecifyMapMatch(id);
	}
	return PLUGIN_HANDLED;
}

// ::: 当前地图: 逐个分配参赛玩家入队, 完成后强制非参赛玩家转 spec
stock beginCurrentMapMatch() {
	g_eState = S_STARTING;
	client_print(0, print_chat, "[报名] 开始分配参赛玩家队伍...");

	// 直接开始逐个分配, 不再清空所有玩家到观战席
	// (参赛玩家由 rg_set_user_team 自动切换队伍, 非参赛玩家在分配完成后强制 /spec)
	g_iAssignPhase = 0;
	g_iAssignIndex = 0;
	remove_task(TASK_ASSIGN_PLAYERS);
	set_task(0.5, "taskAssignPlayersOneByOne", TASK_ASSIGN_PLAYERS);
}

// 逐个分配: 先 A队→T, 再 B队→CT, 最后开赛
// ★ 分配后强制重生, 解决从观战席拉到队伍后死亡无法复活的问题
public taskAssignPlayersOneByOne() {
	if (g_iAssignPhase == 0) {
		// 分配 A 队 (T 方)
		if (g_iAssignIndex < g_iTeamACount) {
			new id = findIdByAuth(g_szTeamA[g_iAssignIndex]);
			if (id > 0 && is_user_connected(id)) {
				rg_set_user_team(id, TEAM_TERRORIST, MODEL_AUTO);
				g_plr[id][SP_TEAM] = 1;
				// ★ 强制重生, 解决观战→T后死亡无法复活的问题
				rg_round_respawn(id);
				new szName[32]; get_user_name(id, szName, charsmax(szName));
				client_print(0, print_chat, "[报名] 分配 %s → T (A队)", szName);
			}
			// 未在线的跳过
			g_iAssignIndex++;
			set_task(0.5, "taskAssignPlayersOneByOne", TASK_ASSIGN_PLAYERS);
			return;
		}
		// A 队分完, 切到 B 队
		g_iAssignPhase = 1;
		g_iAssignIndex = 0;
		set_task(0.5, "taskAssignPlayersOneByOne", TASK_ASSIGN_PLAYERS);
		return;
	}

	if (g_iAssignPhase == 1) {
		// 分配 B 队 (CT 方)
		if (g_iAssignIndex < g_iTeamBCount) {
			new id = findIdByAuth(g_szTeamB[g_iAssignIndex]);
			if (id > 0 && is_user_connected(id)) {
				rg_set_user_team(id, TEAM_CT, MODEL_AUTO);
				g_plr[id][SP_TEAM] = 2;
				// ★ 强制重生, 解决观战→CT后死亡无法复活的问题
				rg_round_respawn(id);
				new szName[32]; get_user_name(id, szName, charsmax(szName));
				client_print(0, print_chat, "[报名] 分配 %s → CT (B队)", szName);
			}
			g_iAssignIndex++;
			set_task(0.5, "taskAssignPlayersOneByOne", TASK_ASSIGN_PLAYERS);
			return;
		}
		// 全部分配完毕, 通知主插件开始比赛
		client_print(0, print_chat, "[报名] 队伍分配完毕, 开始比赛!");
		call_begin_match();

		// ★ 强制所有非参赛玩家转观战: AI 直接让未参赛玩家 say /spec
		//   不是提醒, 是直接强制他们进入观战模式
		forceNonParticipantsToSpec();
		return;
	}
}

// ::: 指定地图: 保存恢复, 然后打开主插件的 /maps 菜单供管理员选图
stock beginSpecifyMapMatch(id) {
	g_eState = S_STARTING;
	client_print(0, print_chat, "[报名] 请在地图列表中选择地图...");

	// 保存恢复数据 (换图后 checkRecovery 恢复)
	savePending();

	// 打开主插件的地图列表菜单
	client_cmd(id, "say /maps");
}
stock beginRandomMapMatch(id) {
	new szMap[64];
	if (!pickRandomMap(szMap, charsmax(szMap))) {
		client_print(id, print_chat, "[报名] 随机地图池为空, 使用当前地图。");
		beginCurrentMapMatch();
		return;
	}

	g_eState = S_STARTING;
	client_print(0, print_chat, "[报名] 随机地图: %s, 3 秒后切换...", szMap);

	// 保存恢复数据
	savePending();

	set_hudmessage(255, 255, 255, -1.0, 0.0, 0, 0.0, 3.0, 0.0, 0.0);
	ShowSyncHudMsg(0, g_iHudSync, "随机地图: %s^n3 秒后切换...", szMap);

	remove_task(TASK_CHANGEMAP);
	set_task(3.0, "taskDoChangemap", TASK_CHANGEMAP, szMap, sizeof(szMap));
}

public taskDoChangemap(const szMap[]) {
	server_cmd("changelevel %s", szMap);
}

// ::: 从 hns-maps.ini 随机选 (skill + boost 混合)
stock bool:pickRandomMap(szOut[], iLen) {
	new szMapsPath[128];
	get_configsdir(szMapsPath, charsmax(szMapsPath));
	add(szMapsPath, charsmax(szMapsPath), "/mixsystem/hns-maps.ini");

	if (!file_exists(szMapsPath)) return false;

	new Array:arrPool = ArrayCreate(32);
	new f = fopen(szMapsPath, "rt");
	if (!f) { ArrayDestroy(arrPool); return false; }

	new szLine[128], szSection[32];
	while (!feof(f)) {
		fgets(f, szLine, charsmax(szLine));
		trim(szLine);
		if (szLine[0] == EOS || szLine[0] == ';' || szLine[0] == '#') continue;

		if (szLine[0] == '[') {
			copy(szSection, charsmax(szSection), szLine);
			replace(szSection, charsmax(szSection), "[", "");
			replace(szSection, charsmax(szSection), "]", "");
			strtolower(szSection);
			continue;
		}

		new szMap[32], szRest[96];
		parse(szLine, szMap, charsmax(szMap), szRest, charsmax(szRest));
		if (szMap[0] == EOS) continue;

		if (equal(szSection, "skill") || equal(szSection, "boost") || equal(szSection, "boss")) {
			// 只添加服务器上确实存在的 BSP 地图文件, 不存在的跳过
			if (is_map_valid(szMap))
				ArrayPushString(arrPool, szMap);
		}
	}
	fclose(f);

	new iSize = ArraySize(arrPool);
	if (iSize <= 0) { ArrayDestroy(arrPool); return false; }

	ArrayGetString(arrPool, random(iSize), szOut, iLen);
	ArrayDestroy(arrPool);
	return true;
}

// ==================== 清理所有玩家到观战席 ====================
// 清除所有在线玩家 (含人机/机器人) 到观战席, 避免人机自动入队
stock clearAllToSpectator() {
	for (new i = 1; i <= MAX_PLAYERS; i++) {
		if (is_user_connected(i))
			rg_set_user_team(i, TEAM_SPECTATOR);
	}
}

// ==================== 强制非参赛玩家转观战 ====================
// 在队伍分配完成后, 直接调用引擎原生 jointeam 6 切到观战队伍
// 参考隔壁 OpenHNS 的实现: 只用 MOVETYPE_FLY, 不设 health=0, 不手动干预观察者模式
stock forceNonParticipantsToSpec() {
	for (new i = 1; i <= MAX_PLAYERS; i++) {
		if (!is_user_connected(i)) continue;

		// 检查该玩家是否在参赛名单中 (A队或B队)
		if (isPlayerInMatch(i)) continue;

		// 已在观战队伍的跳过
		if (get_member(i, m_iTeam) == TEAM_SPECTATOR) continue;

		// ★ 直接调用引擎原生 jointeam 6 切到观战队伍, 不走 rg_set_user_team
		if (is_user_alive(i)) {
			user_silentkill(i);
		}
		rg_internal_cmd(i, "jointeam", "6");

		// 原封不动搬隔壁 OpenHNS: jointeam 6 → SOLID_NOT → MOVETYPE_FLY
		set_pev(i, pev_solid, SOLID_NOT);
		set_pev(i, pev_movetype, MOVETYPE_FLY);

		client_print(i, print_chat, "[报名] 你未参与本场比赛, 已自动转入观战模式。");
	}
}

// ★ 检查玩家是否在参赛名单中 (A队或B队)
stock bool:isPlayerInMatch(id) {
	new szAuth[35];
	getPlayerAuth(id, szAuth, charsmax(szAuth));

	for (new i = 0; i < g_iTeamACount; i++) {
		if (equal(szAuth, g_szTeamA[i])) return true;
	}
	for (new i = 0; i < g_iTeamBCount; i++) {
		if (equal(szAuth, g_szTeamB[i])) return true;
	}
	return false;
}

// ==================== 通知主插件开始比赛 (改用主插件官方 native 接口) ====================
// 原先用跨插件 callfunc 调用 cmdStartMatch / handleSponsorPickMenu 极不可靠,
// 常常因找不到函数而静默失败, 导致"AI 报名后比赛开不起来"。
// 现改用 HnsMatchSystem 专门为报名插件开放的 native:
//   hns_external_set_match_mode  / hns_external_set_match_time  (开赛前预设)
//   hns_begin_external_match     (真正开赛, 走"比赛即将开始"缓冲期)
stock call_begin_match() {
	// 1. 事先设置比赛模式 (1=MR 2=Wintime 3=Duel 4=Ascension 5=Vampire 6=Rounds)
	new iMode = g_iSelectedMode;
	if (iMode < 1 || iMode > 6) iMode = 1;
	hns_external_set_match_mode(iMode);

	// 2. 事先设置比赛时间 (仅当已选择; native 内部有兜底)
	if (g_iSelectedTime > 0)
		hns_external_set_match_time(g_iSelectedTime);

	// 2.1 回合制: 事先设置打满分数
	if (g_iSelectedMode == 6 && g_iSelectedScore > 0)
		hns_external_set_match_score(g_iSelectedScore);

	// 3. 直接开赛: 传入本场类型(赞助/娱乐)与发起者
	//    返回 1=成功; 0=失败(已有比赛/刀战地图/非空闲状态)
	if (hns_begin_external_match(g_bSponsorMode, g_iChosenStarter))
		client_print(0, print_chat, "[报名] 比赛即将开始! (%s)", g_szModeNames[g_iSelectedMode]);
	else
		client_print(0, print_chat, "[报名] 开始比赛失败 (模式冲突/刀战地图/已有比赛), 请手工 /startmix。");
}

// 找一个当前在线且能控制报名的玩家 (管理/观察者), 返回 0 表示无
stock get_any_controller() {
	new iPlayers[MAX_PLAYERS], iNum;
	get_players(iPlayers, iNum, "ch");
	for (new i = 0; i < iNum; i++) {
		if (isControllable(iPlayers[i]))
			return iPlayers[i];
	}
	return 0;
}

// ==================== 随机地图换图恢复 ====================
stock savePending() {
	new szFile[128];
	buildPendingPath(szFile, charsmax(szFile));

	new f = fopen(szFile, "wt");
	if (!f) return;

	fprintf(f, "sponsor %d^n", g_bSponsorMode);
	fprintf(f, "mode %d^n", g_iSelectedMode);
	fprintf(f, "time %d^n", g_iSelectedTime);
	fprintf(f, "score %d^n", g_iSelectedScore);
	fprintf(f, "starter %s^n", g_szAuth[g_iChosenStarter]);
	for (new i = 0; i < g_iTeamACount; i++) fprintf(f, "teama %s^n", g_szTeamA[i]);
	for (new i = 0; i < g_iTeamBCount; i++) fprintf(f, "teamb %s^n", g_szTeamB[i]);
	fclose(f);
}

stock buildPendingPath(szOut[], iLen) {
	get_configsdir(szOut, iLen);
	add(szOut, iLen, "/mixsystem");
	if (!dir_exists(szOut)) mkdir(szOut);
	format(szOut, iLen, "%s/%s", szOut, PENDING_FILE);
}

stock checkRecovery() {
	new szFile[128];
	buildPendingPath(szFile, charsmax(szFile));
	if (!file_exists(szFile)) return;

	new f = fopen(szFile, "rt");
	if (!f) return;

	new szLine[256];
	g_iTeamACount = 0;
	g_iTeamBCount = 0;
	g_bPendingSponsor = false;
	g_iPendingMode = 1;  // 默认 MR

	while (!feof(f) && fgets(f, szLine, charsmax(szLine))) {
		trim(szLine);
		if (szLine[0] == EOS) continue;
		new szKey[32], szVal[64];
		parse(szLine, szKey, charsmax(szKey), szVal, charsmax(szVal));

		if (equal(szKey, "sponsor")) g_bPendingSponsor = (str_to_num(szVal) == 1);
		else if (equal(szKey, "mode")) g_iPendingMode = str_to_num(szVal);
		else if (equal(szKey, "time")) g_iSelectedTime = str_to_num(szVal);
		else if (equal(szKey, "score")) g_iSelectedScore = str_to_num(szVal);
		else if (equal(szKey, "starter") && g_iChosenStarter <= 0) g_iChosenStarter = findIdByAuth(szVal);
		else if (equal(szKey, "teama") && g_iTeamACount < MAX_PLAYERS) { copy(g_szTeamA[g_iTeamACount], 34, szVal); g_iTeamACount++; }
		else if (equal(szKey, "teamb") && g_iTeamBCount < MAX_PLAYERS) { copy(g_szTeamB[g_iTeamBCount], 34, szVal); g_iTeamBCount++; }
	}
	fclose(f);
	delete_file(szFile);

	g_bTeamsAssigned = true;
	g_eState = S_READY;
	g_bPendingWait = true;
	g_iPendingWaitCount = 0;
	g_bSponsorMode = g_bPendingSponsor;
	g_iSelectedMode = g_iPendingMode;

	client_print(0, print_chat, "[报名] 恢复分组: %dv%d, 等待玩家连接后自动开赛...", g_iTeamACount, g_iTeamBCount);

	remove_task(TASK_RECOVERY_WAIT);
	set_task(1.0, "taskRecoveryWait", TASK_RECOVERY_WAIT, _, _, "b");
}

public taskRecoveryWait() {
	if (!g_bPendingWait) { remove_task(TASK_RECOVERY_WAIT); return; }

	g_iPendingWaitCount++;

	new iConnected = 0, iNeeded = g_iTeamACount + g_iTeamBCount;
	for (new i = 0; i < g_iTeamACount; i++) if (findIdByAuth(g_szTeamA[i]) > 0) iConnected++;
	for (new i = 0; i < g_iTeamBCount; i++) if (findIdByAuth(g_szTeamB[i]) > 0) iConnected++;

	new iRemain = 30 - g_iPendingWaitCount;
	if (iRemain < 0) iRemain = 0;

	set_hudmessage(255, 200, 0, -1.0, 0.15, 0, 0.0, 1.0, 0.0, 0.0);
	ShowSyncHudMsg(0, g_iHudSync, "等待玩家连接...^n已连接: %d/%d^n%d 秒后将清理观战席并分配队伍", iConnected, iNeeded, iRemain);

	// 固定 30 秒后开始清理 + 逐个分配
	if (g_iPendingWaitCount >= 30) {
		g_bPendingWait = false;
		remove_task(TASK_RECOVERY_WAIT);
		client_print(0, print_chat, "[报名] 30 秒等待结束, 开始清理并分配队伍...");
		beginCurrentMapMatch();
		return;
	}
}

// ==================== 展示分组 / 命令 ====================
public cmdShowTeams(id) {
	if (!g_bTeamsAssigned) {
		client_print(id, print_chat, "[报名] 还未分组。");
		return PLUGIN_HANDLED;
	}
	showTeamsTo(id);
	return PLUGIN_HANDLED;
}

stock showTeamsTo(id) {
	client_print(id, print_chat, "[报名] ===== 分组结果 =====");
	client_print(id, print_chat, "[T - A队] (%d):", g_iTeamACount);
	for (new i = 0; i < g_iTeamACount; i++) {
		new szN[32]; nameByAuth(g_szTeamA[i], szN, charsmax(szN));
		client_print(id, print_chat, "  %d. %s", i + 1, szN);
	}
	client_print(id, print_chat, "[CT - B队] (%d):", g_iTeamBCount);
	for (new i = 0; i < g_iTeamBCount; i++) {
		new szN[32]; nameByAuth(g_szTeamB[i], szN, charsmax(szN));
		client_print(id, print_chat, "  %d. %s", i + 1, szN);
	}
}

// ==================== 比赛开始/结束检测 + 冷却 ====================
// 主插件比赛开始时触发
public hns_match_started() {
	// 仅当是我们报名系统发起的才处理
	if (g_eState != S_STARTING && g_eState != S_READY) return;

	client_print(0, print_chat, "^4[HNS] ^2比赛已开始! 模式: %s", g_szModeNames[g_iSelectedMode]);
}

// 主插件比赛结束时触发 (自然结束)
public hns_match_finished(iWinTeam) {
	// 仅当是我们报名系统发起的才处理
	if (g_eState != S_STARTING && g_eState != S_READY) return;

	matchEndCleanup();
}

// 主插件比赛被手动取消时触发
public hns_match_canceled() {
	if (g_eState != S_STARTING && g_eState != S_READY) return;

	matchEndCleanup();
}

stock matchEndCleanup() {
	// 绿色消息: [HNS] 比赛已经结束
	set_hudmessage(0, 255, 0, -1.0, 0.35, 0, 0.0, 4.0, 0.0, 0.0);
	ShowSyncHudMsg(0, g_iHudSync, "比赛已经结束");

	client_print(0, print_chat, "^4[HNS] ^2比赛已经结束。");

	// 清理报名状态
	signupCancel(0);

	// 启动 AI 报名冷却 20 秒
	g_bCooldown = true;
	g_iCooldownRemaining = 20;
	remove_task(TASK_COOLDOWN);
	set_task(1.0, "taskSignupTick", TASK_COOLDOWN, _, _, "b");
	client_print(0, print_chat, "[报名] AI 报名冷却 %d 秒...", g_iCooldownRemaining);
}

// ==================== 取消 / 清理 ====================
stock signupCancel(id) {
	g_eState = S_IDLE;
	g_iSignedCount = 0;
	g_iTeamACount = 0;
	g_iTeamBCount = 0;
	g_bTeamsAssigned = false;
	g_bPendingWait = false;
	g_bSponsorMode = false;
	g_bCooldown = false;
	g_bVoting = false;
	g_iSelectedTime = 0;
	g_iSelectedScore = 0;
	remove_task(TASK_COOLDOWN);
	remove_task(TASK_VOTE_TIMEOUT);
	for (new i = 1; i <= MAX_PLAYERS; i++) {
		g_plr[i][SP_SIGNED] = false;
		g_plr[i][SP_TEAM] = 0;
		g_szAuth[i][0] = EOS;
	}
	remove_task(TASK_MAP_TIMEOUT);
	remove_task(TASK_RECOVERY_WAIT);
	remove_task(TASK_ASSIGN_PLAYERS);
	if (id > 0) client_print(0, print_chat, "[报名] 管理 %n 取消了报名。", id);
	else client_print(0, print_chat, "[报名] 报名已取消。");
}

// ==================== 玩家事件 ====================
public client_disconnected(id) {
	if (g_eState == S_SIGNUP && g_plr[id][SP_SIGNED]) {
		g_plr[id][SP_SIGNED] = false;
		g_plr[id][SP_TEAM] = 0;
		g_iSignedCount--;
		if (g_iSignedCount < 0) g_iSignedCount = 0;
		if (g_iSignedCount <= 0) signupCancel(0);
	}
}