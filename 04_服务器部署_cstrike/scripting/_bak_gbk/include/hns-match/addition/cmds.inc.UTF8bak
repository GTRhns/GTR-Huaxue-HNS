public cmdStartPause(id) {
	// ★ 防重复：1秒内不允许重复暂停
	new Float:flNow = get_gametime();
	if (flNow - g_flLastPauseTime < 1.0) {
		return PLUGIN_HANDLED;
	}
	g_flLastPauseTime = flNow;

	if (!isUserWatcher(id)) {
		client_print(id, print_chat, "[Pause] 你没有权限暂停!");
		return PLUGIN_HANDLED;
	}

	if (g_eMatchState == STATE_PAUSED) {
		client_print(id, print_chat, "[Pause] 比赛已经暂停了!");
		return PLUGIN_HANDLED;
	}

	// ★ 直接用 if-else 调用，避免 Pawn switch fall-through
	if (g_iCurrentMode == MODE_MIX) {
		mix_pause();
	} else if (g_iCurrentMode == MODE_KNIFE) {
		kniferound_pause();
	} else if (g_iCurrentMode == MODE_ASCENSION) {
		ascension_pause();
	} else if (g_iCurrentMode == MODE_VAMP) {
		vamp_pause();
	} else if (g_iCurrentMode == MODE_ROUNDS) {
		rounds_pause();
	} else if (g_ModFuncs[g_iCurrentMode][MODEFUNC_PAUSE]) {
		ExecuteForward(g_ModFuncs[g_iCurrentMode][MODEFUNC_PAUSE], _);
	} else {
		client_print(id, print_chat, "[Pause] 当前模式不支持暂停!");
		return PLUGIN_HANDLED;
	}

	client_cmd(0, "spk fvox/deactivated.wav");
	chat_print(0, "^3%n^1 暂停了游戏!", id);

	return PLUGIN_HANDLED;
}

public cmdStopPause(id) {
	if (!isUserWatcher(id)) {
		return PLUGIN_HANDLED;
	}
	
	if (g_eMatchState != STATE_PAUSED) {
		return PLUGIN_HANDLED;
	}

	// ★ 直接用 if-else 调用，避免 switch fall-through
	if (g_iCurrentMode == MODE_MIX) {
		mix_unpause();
	} else if (g_iCurrentMode == MODE_KNIFE) {
		kniferound_unpause();
	} else if (g_iCurrentMode == MODE_ASCENSION) {
		ascension_unpause();
	} else if (g_iCurrentMode == MODE_VAMP) {
		vamp_unpause();
	} else if (g_iCurrentMode == MODE_ROUNDS) {
		rounds_unpause();
	} else if (g_ModFuncs[g_iCurrentMode][MODEFUNC_UNPAUSE]) {
		ExecuteForward(g_ModFuncs[g_iCurrentMode][MODEFUNC_UNPAUSE], _);
	} else {
		return PLUGIN_HANDLED;
	}

	client_cmd(0, "spk fvox/activated.wav");
	chat_print(0, "^3%n^1 恢复了游戏!", id);

	return PLUGIN_HANDLED;
}

public cmdSurrender(id) {
	if (!is_user_connected(id))
		return PLUGIN_HANDLED;

	if (g_iCurrentMode != MODE_MIX)
		return PLUGIN_HANDLED;

	if (!getUserInMatch(id))
		return PLUGIN_HANDLED;

	if (g_eSurrenderData[e_sStarted])
		return PLUGIN_HANDLED;

	if (g_eSurrenderData[e_sFlDelay] > get_gametime()) {
		new szTime[24];
		fnConvertTime(g_eSurrenderData[e_sFlDelay] - get_gametime(), szTime, 23, false);
		chat_print(id, "投降还需等待 %s。", szTime);
		return PLUGIN_HANDLED;
	}

	new iPlayers[MAX_PLAYERS], iNum;
	get_players(iPlayers, iNum, "che", getUserTeam(id) == TEAM_TERRORIST ? "TERRORIST" : "CT");

	if (iNum != g_eMatchInfo[e_mTeamSizeTT])
		return PLUGIN_HANDLED;

	g_eSurrenderData[e_sStarted] = true;
	g_eSurrenderData[e_sInitiator] = id;
	g_eSurrenderData[e_sFlDelay] = get_gametime() + g_iSettings[SURTIMEDELAY];
	chat_print(0, "玩家 ^3%n^1 (^3%s^1) 发起了投降投票!", id, getUserTeam(id) == TEAM_TERRORIST ? "恐怖分子" : "反恐精英");

	for (new i; i < iNum; i++) {
		new iPlayer = iPlayers[i];
		surrenderMenu(iPlayer);
	}
	set_task(1.0, "taskSurrender", TASK_SURRENDER, .flags = "b");

	return PLUGIN_HANDLED;
}

public cmdShowTimers(id) {
	if (g_iCurrentMode == MODE_ROUNDS) {
		// 回合制比分 (AI报名开的比赛在每回合开头调用 /score 显示)
		new iCt, iTt;
		if (g_isTeamTT == HNS_TEAM_A) { iTt = g_iRoundsScoreT; iCt = g_iRoundsScoreCT; }
		else { iTt = g_iRoundsScoreCT; iCt = g_iRoundsScoreT; }
		chat_print(id, "Rounds: [CT] ^3%d^1 : [TT] ^3%d^1 (A ^3%d^1 - ^3%d^1 B)", iCt, iTt, g_iRoundsScoreT, g_iRoundsScoreCT);
		return PLUGIN_HANDLED;
	}
	if (g_iCurrentMode != MODE_MIX) {
		return PLUGIN_HANDLED;
	}

	new szTimeToWin[HNS_TEAM][24], szTimeDiff[24];

	new Float:fTimeDiff = floatabs(g_eMatchInfo[e_flSidesTime][g_isTeamTT] - g_eMatchInfo[e_flSidesTime][HNS_TEAM:!g_isTeamTT]);
	fnConvertTime(fTimeDiff, szTimeDiff, charsmax(szTimeDiff), false);

	if (g_iCurrentRules == RULES_MR) {
	    {
	    			fnConvertTime(Float:g_eMatchInfo[e_flSidesTime][HNS_TEAM_B], szTimeToWin[HNS_TEAM_B], 23);
	    			fnConvertTime(Float:g_eMatchInfo[e_flSidesTime][HNS_TEAM_A], szTimeToWin[HNS_TEAM_A], 23);

	    			new iPlayers[MAX_PLAYERS], TTsize, CTSize;
	    			get_players(iPlayers, TTsize, "che", "TERRORIST");
	    			get_players(iPlayers, CTSize, "che", "CT");
	    			if (g_isTeamTT == HNS_TEAM_A) {
	    				chat_print(id, "TT [^3%s^1] %d vs %d [^3%s^1] CT (^3%d^1/^3%d^1 回合) (^3%s^1 差距)",
	    					szTimeToWin[HNS_TEAM_A], TTsize, CTSize, szTimeToWin[HNS_TEAM_B],
	    					(g_eMatchInfo[e_iSidesRounds][HNS_TEAM_A] + g_eMatchInfo[e_iSidesRounds][HNS_TEAM_B]) + 1, g_iSettings[MAXROUNDS] * 2,
	    					szTimeDiff);
	    			} else {
	    				chat_print(id, "TT [^3%s^1] %d vs %d [^3%s^1] CT (^3%d^1/^3%d^1 回合) (^3%s^1 差距)",
	    					szTimeToWin[HNS_TEAM_B], TTsize, CTSize, szTimeToWin[HNS_TEAM_A],
	    					(g_eMatchInfo[e_iSidesRounds][HNS_TEAM_B] + g_eMatchInfo[e_iSidesRounds][HNS_TEAM_A]) + 1, g_iSettings[MAXROUNDS] * 2,
	    					szTimeDiff);
	    			}
	    		}
	} else if (g_iCurrentRules == RULES_TIMER) {
	    {
	    			new Float:flCapTime = floatmul(g_eMatchInfo[e_mWintime], 60.0);
	    			new Float:flTimeToWinA = floatsub(flCapTime, Float:g_eMatchInfo[e_flSidesTime][HNS_TEAM_A]);
	    			new Float:flTimeToWinB = floatsub(flCapTime, Float:g_eMatchInfo[e_flSidesTime][HNS_TEAM_B]);
	    			fnConvertTime(flTimeToWinA, szTimeToWin[HNS_TEAM_A], 23);
	    			fnConvertTime(flTimeToWinB, szTimeToWin[HNS_TEAM_B], 23);
	    			if (g_isTeamTT == HNS_TEAM_A) {
	    				chat_print(id, "TT [^3%s^1] vs [^3%s^1] CT (^3%s^1 差距)", szTimeToWin[HNS_TEAM_A], szTimeToWin[HNS_TEAM_B], szTimeDiff);
	    			} else {
	    				chat_print(id, "TT [^3%s^1] vs [^3%s^1] CT (^3%s^1 差距)", szTimeToWin[HNS_TEAM_B], szTimeToWin[HNS_TEAM_A], szTimeDiff);
	    			}
	    		}
	} else if (g_iCurrentRules == RULES_DUEL) {
	    {
	    			new Float:flScoreA = Float:g_eMatchInfo[e_flSidesTime][HNS_TEAM_A];
	    			new Float:flScoreB = Float:g_eMatchInfo[e_flSidesTime][HNS_TEAM_B];

	    			new ttPlayers[MAX_PLAYERS], ctPlayers[MAX_PLAYERS], ttNum, ctNum;
	    			get_players(ttPlayers, ttNum, "he", "TERRORIST");
	    			get_players(ctPlayers, ctNum, "he", "CT");

	    			new iPlayerA, iPlayerB;
	    			if (g_isTeamTT == HNS_TEAM_A) {
	    				iPlayerA = ttPlayers[0];
	    				iPlayerB = ctPlayers[0];
	    			} else {
	    				iPlayerA = ctPlayers[0];
	    				iPlayerB = ttPlayers[0];
	    			}

	    			new szTime[24];
	    			fnConvertTime(g_flPointsMatchTime, szTime, charsmax(szTime), false);

	    			chat_print(id, "比分: ^3%n^1 ^4%.1f^1 vs ^4%.1f^1 ^3%n^1 | 时间: ^3%s", iPlayerA, flScoreA, flScoreB, iPlayerB, szTime);
	    		}
	}

	return PLUGIN_HANDLED;
}

public cmdTeamSpec(id) {
	// ★ 所有模式下都允许 /spec, 未参与比赛的玩家直接转观战
	if (g_iCurrentMode == MODE_PUB || g_iCurrentMode == MODE_DM || g_iCurrentMode == MODE_TRAINING || g_iCurrentMode == MODE_MIX) {
		if (getUserTeam(id) == TEAM_SPECTATOR) {
			// 允许从观战回到比赛 (仅限非比赛模式)
			if (g_iCurrentMode != MODE_MIX) {
				new iNumTT = get_playersnum_ex(GetPlayers_MatchTeam, "TERRORIST");
				new iNumCT = get_playersnum_ex(GetPlayers_MatchTeam, "CT");
				if (iNumTT == iNumCT && g_eSpecBack[id] != TEAM_UNASSIGNED) {
					rg_set_user_team(id, g_eSpecBack[id]);
				} else if (iNumTT < iNumCT) {
					rg_set_user_team(id, TEAM_TERRORIST);
				} else {
					rg_set_user_team(id, TEAM_CT);
				}
				if (g_iCurrentMode == MODE_PUB) {
					if (rg_is_player_can_respawn(id)) {
						rg_round_respawn(id);
					}
				} else {
					rg_round_respawn(id);
				}
			}
		} else {
			g_eSpecBack[id] = getUserTeam(id);
			transferUserToSpec(id);
		}
	} else {
		// 比赛模式: 直接转观战, 不可回场
		transferUserToSpec(id);
	}
}

public cmdNoplay(id) {
	if (!g_bNoplay[id]) {
		g_bNoplay[id] = true;
		chat_print(0, "^3%n^1 当前 ^3不可选^1。 [^3NOPLAY^1]", id);
	}
}

public cmdPlay(id) {
	if (g_bNoplay[id]) {
		g_bNoplay[id] = false;
		chat_print(0, "^3%n^1 现在 ^3可选^1。 [^3PLAY^1]", id);
	}
}

stock RegisterSayCmd(const szCmd[], const szShort[], const szFunc[], flags = -1, szInfo[] = "") {
	new szTemp[65], szInfoLang[65];
	copy(szInfoLang, 64, szInfo);

	format(szTemp, 64, "say /%s", szCmd);
	register_clcmd(szTemp, szFunc, flags, szInfoLang);

	format(szTemp, 64, "say .%s", szCmd);
	register_clcmd(szTemp, szFunc, flags, szInfoLang);

	format(szTemp, 64, "/%s", szCmd);
	register_clcmd(szTemp, szFunc, flags, szInfoLang);

	format(szTemp, 64, "%s", szCmd);
	register_clcmd(szTemp, szFunc, flags, szInfoLang);

	format(szTemp, 64, "say /%s", szShort);
	register_clcmd(szTemp, szFunc, flags, szInfoLang);

	format(szTemp, 64, "say .%s", szShort);
	register_clcmd(szTemp, szFunc, flags, szInfoLang);

	format(szTemp, 64, "/%s", szShort);
	register_clcmd(szTemp, szFunc, flags, szInfoLang);

	format(szTemp, 64, "%s", szShort);
	register_clcmd(szTemp, szFunc, flags, szInfoLang);

	return 1;
}

// Training menu entry point (delegates to hnsmenu.inc)
public cmdTrainingMenuEntry(id) {
	if (!is_user_connected(id))
		return;
	showTrainingMenu(id);
}

// ============================================================================
// ★ 独立报名插件接口 (原生实现)
// 由 natives.inc 注册, 此处实现 (须在 start_match_buffer 之后定义)
// ============================================================================
// hns_external_set_sponsor(赞助?, 玩家): 开赛前预先设置本场是否为赞助局
public native_hns_external_set_sponsor(amxx, params) {
	enum { argSponsor = 1, argPlayer = 2 };
	new bool:bSponsor = bool:get_param(argSponsor);
	new iPlayer = get_param(argPlayer);

	if (bSponsor) {
		g_bSponsorMatch = true;
		g_bPersistentSponsor = true;
		g_iSponsorPlayer = iPlayer > 0 ? iPlayer : 0;
	} else {
		g_bSponsorMatch = false;
		g_bPersistentSponsor = false;
		g_iSponsorPlayer = 0;
	}
	return 1;
}

// hns_begin_external_match(赞助?, 发起人): 直接开始比赛 (比赛即将开始 + 进度条 + 开赛)
public native_hns_begin_external_match(amxx, params) {
	enum { argSponsor = 1, argStarter = 2 };
	new bool:bSponsor = bool:get_param(argSponsor);
	new iStarter = get_param(argStarter);

	// ★ 强制切换到训练模式: 无论当前是什么模式, 都先进入训练模式再开始比赛
	//   解决"报名后缓冲期仍显示公共模式"的问题
	if (g_iCurrentMode != MODE_TRAINING) {
		training_start();
		chat_print(0, "^3[HNS] ^1已自动切换到训练模式, 准备开始比赛。");
	}
	// ★ 换图后 PDS 可能恢复 MATCH_MAPPICK/WaitConnect 等残留状态,
	//    这些不是真正的比赛进行中, 强制重置即可
	if (g_iMatchStatus == MATCH_STARTED || g_iMatchStatus == MATCH_TEAMKNIFE) {
		chat_print(0, "^3[HNS] ^1报名系统无法开始比赛: 已有比赛/拼刀在进行。");
		return 0;
	}
	g_iMatchStatus = MATCH_NONE;
	if (hns_is_knife_map()) {
		chat_print(0, "^3[HNS] ^1报名系统无法开始比赛: 当前是刀战地图。");
		return 0;
	}

	// 移除可能残留的缓冲期任务
	if (task_exists(TASK_MATCH_BUFFER)) remove_task(TASK_MATCH_BUFFER);
	if (task_exists(TASK_SPONSOR_PICK)) remove_task(TASK_SPONSOR_PICK);

	// 设置赞助局状态
	if (bSponsor) {
		g_bSponsorMatch = true;
		g_bPersistentSponsor = true;
		g_iSponsorPlayer = iStarter > 0 ? iStarter : 0;
	} else {
		g_bSponsorMatch = false;
		g_bPersistentSponsor = false;
		g_iSponsorPlayer = 0;
	}

	g_iMatchStarter = iStarter > 0 ? iStarter : 0;

	// 如果是回合制模式, 不走缓冲期, 直接启动 rounds_start()
	// 回合制基于 MR 规则, 需要先重置规则
	if (g_iCurrentRules == RULES_ROUNDS) {
		g_iCurrentRules = RULES_MR;
		rounds_start();
		return 1;
	}

	// 开始比赛缓冲期 ("比赛即将开始" + 进度条 + mix_start)
	start_match_buffer();
	return 1;
}

// hns_external_set_match_time(时间分钟): 开赛前预先设置比赛时间
public native_hns_external_set_match_time(amxx, params) {
	enum { argTime = 1 };
	new iMinutes = get_param(argTime);

	if (iMinutes < 1) iMinutes = 15; // 最小 1 分钟, 兜底 15

	g_eMatchInfo[e_mWintime] = float(iMinutes);
	cvar_update_wintime(float(iMinutes));
	chat_print(0, "^3[HNS] ^1比赛时间已设置为: ^3%d 分钟^1。", iMinutes);
	return 1;
}

public native_hns_external_set_match_score(amxx, params) {
	enum { argScore = 1 };
	new iScore = get_param(argScore);
	if (iScore < 0) iScore = 0;
	g_iRoundsTargetScore = iScore;
	if (iScore > 0) {
		chat_print(0, "^3[HNS] ^1Rounds target set: play to ^3%d^1 (higher score wins, tie=overtime).", iScore);
	} else {
		chat_print(0, "^3[HNS] ^1Rounds target cleared, using default fixed rounds.");
	}
	return 1;
}

// hns_external_set_match_mode(模式编号): 开赛前预先设置比赛模式
// 模式编号: 1=MR, 2=Wintime, 3=Duel, 4=Ascension, 5=Vampire, 6=Rounds
public native_hns_external_set_match_mode(amxx, params) {
	enum { argMode = 1 };
	new iMode = get_param(argMode);

	// ★ 强制切换到训练模式, 确保缓冲期不会显示公共模式
	//   (报名系统调用时当前模式可能是 PUBLIC/其他, 必须强制切到训练模式)
	if (g_iCurrentMode != MODE_TRAINING) {
		training_start();
		chat_print(0, "^3[HNS] ^1已自动切换到训练模式。");
	}
	if (g_iMatchStatus != MATCH_NONE) {
		chat_print(0, "^3[HNS] ^1报名系统无法设置模式: 已有比赛在进行。");
		return 0;
	}

	switch (iMode) {
		case 1: { // MR
			g_iCurrentRules = RULES_MR;
			set_pcvar_string(pCvar[GAMENAME], "HNS Mix [MR]");
			chat_print(0, "^3[HNS] ^1比赛模式已设置为: ^3MR (最大回合数)^1。");
		}
		case 2: { // Wintime
			g_iCurrentRules = RULES_TIMER;
			set_pcvar_string(pCvar[GAMENAME], "HNS Mix [Wintime]");
			chat_print(0, "^3[HNS] ^1比赛模式已设置为: ^3计时模式^1。");
		}
		case 3: { // Duel
			g_iCurrentRules = RULES_DUEL;
			set_pcvar_string(pCvar[GAMENAME], "HNS Mix [Duel]");
			chat_print(0, "^3[HNS] ^1比赛模式已设置为: ^3决斗 (1v1)^1。");
		}
		case 4: { // Ascension
			g_iCurrentRules = RULES_POINTSCAP;
			set_pcvar_string(pCvar[GAMENAME], "HNS Mix [Ascension]");
			chat_print(0, "^3[HNS] ^1比赛模式已设置为: ^3突围模式^1。");
		}
		case 5: { // Vampire
			g_iCurrentRules = RULES_VAMP;
			set_pcvar_string(pCvar[GAMENAME], "HNS Mix [Vampire]");
			chat_print(0, "^3[HNS] ^1比赛模式已设置为: ^3吸血模式^1。");
		}
		case 6: { // Rounds
			g_iCurrentRules = RULES_ROUNDS;
			set_pcvar_string(pCvar[GAMENAME], "HNS Mix [Rounds]");
			chat_print(0, "^3[HNS] ^1比赛模式已设置为: ^3回合制^1。");
		}
		default: {
			chat_print(0, "^3[HNS] ^1无效的比赛模式编号: %d", iMode);
			return 0;
		}
	}

	return 1;
}
