// 比赛开始 15 秒缓冲期计数 (全局, 需在使用前声明)
new g_iBufferCount;

public cmdStartMatch(id) {
	if (!isUserWatcher(id) && !is_user_admin(id)) {
		chat_print(id, "你没有权限开始比赛。");
		return PLUGIN_HANDLED;
	}

	if (g_iCurrentMode != MODE_TRAINING) {
		// ★ 非训练模式也能开赛: 先自动切换到训练模式
		//   解决"AI报名后跳转到公共模式, 无法开启比赛"的问题
		chat_print(0, "^3[比赛] ^1当前模式非训练, 自动切换到训练模式开始比赛。");
		training_start();
	} 
	
	if (hns_is_knife_map()) {
		chat_print(id, "刀战地图上无法开始比赛，请改用队长模式。");
		return PLUGIN_HANDLED;
	}

	if (task_exists(TASK_STARTED)) {
		remove_task(TASK_STARTED);
	}

	if (task_exists(TASK_WAIT)) {
		remove_task(TASK_WAIT);
	}

	if (task_exists(TASK_WAIT_CUP)) {
		remove_task(TASK_WAIT_CUP);
	}

	if (task_exists(TASK_MATCH_BUFFER)) {
		remove_task(TASK_MATCH_BUFFER);
	}

	if (task_exists(TASK_SPONSOR_PICK)) {
		remove_task(TASK_SPONSOR_PICK);
	}

	// ★ 记录发起比赛的玩家
	g_iMatchStarter = id;

	// ★ 服务器控制台/换图后自动启动 (id==0): 不弹菜单, 直接按当前赞助局状态启动
	// (保留 g_bSponsorMatch / g_bPersistentSponsor, 播放对应赞助/娱乐声音)
	if (id == 0) {
		start_match_buffer();
		return PLUGIN_HANDLED;
	}

	// ★ 激活比赛瞬间: 弹出 5 秒比赛类型选择菜单 (赞助局 / 比赛局)
	show_sponsor_pick_menu(id);

	return PLUGIN_HANDLED;
}

// ★ 比赛类型选择菜单: 赞助局 / 比赛局 (5秒中断)
stock show_sponsor_pick_menu(id) {
	new szMenu[256];
	copy(szMenu, charsmax(szMenu), "\y比赛类型选择^n^n\r1. \w赞助局^n\r2. \w比赛局 (娱乐)^n^n\y请在 5 秒内选择, 超时默认比赛局");
	show_menu(id, (1<<0)|(1<<1), szMenu, 5, "SponsorPickMenu");

	// 5 秒超时: 默认比赛局
	set_task(5.0, "taskSponsorPickTimeout", TASK_SPONSOR_PICK);
}

// 菜单选择处理
public handleSponsorPickMenu(id, key) {
	if (task_exists(TASK_SPONSOR_PICK)) {
		remove_task(TASK_SPONSOR_PICK);
	}

	if (key == 0) {
		// 赞助局
		g_bSponsorMatch = true;
		g_bPersistentSponsor = true;
		g_iSponsorPlayer = id;
		chat_print(0, "^4[赞助局] ^1本场比赛为 ^4赞助局^1。");
	} else {
		// 比赛局 (娱乐)
		g_bSponsorMatch = false;
		g_bPersistentSponsor = false;
		g_iSponsorPlayer = 0;
		chat_print(0, "^1本场比赛为 ^3比赛局 (娱乐)^1。");
	}

	start_match_buffer();
}

// 5 秒超时: 默认比赛局
public taskSponsorPickTimeout() {
	g_bSponsorMatch = false;
	g_bPersistentSponsor = false;
	g_iSponsorPlayer = 0;
	chat_print(0, "^1未选择比赛类型, 默认 ^3比赛局 (娱乐)^1。");
	start_match_buffer();
}

// ★ 开始比赛缓冲期: 刷新回合 → 10秒练习模式准备期 → 自动开启比赛
//   强制训练模式, 杜绝缓冲期仍显示公共模式的问题
stock start_match_buffer() {
	new id = g_iMatchStarter;

	if (id > 0 && is_user_connected(id))
		chat_print(0, "^3%n^1 已开始 ^3比赛^1。", id);
	else
		chat_print(0, "^3比赛^1 已开始。");

	g_iBufferCount = 0;
	g_bMatchBufferDone = false;
	play_match_about_sound();

	// ★ 缓冲期=练习模式准备期: 强制切换到训练模式, 刷新回合
	//   无论当前是什么模式, 都强制进入训练玩法, 杜绝公共模式残留
	//   并且每轮 buffer tick 都会再次检查强制, 防止被其他逻辑改回
	training_start();

	setTaskHud(0, 0.0, 1, 255, 255, 255, 2.0, "练习模式准备期: %d 秒后自动开始比赛!", 15);
	set_task(1.0, "taskStartMatchBuffer", TASK_MATCH_BUFFER, _, _, "b");
}

// 比赛开始缓冲期任务 (每秒执行一次)
// 阶段1 (0~10秒): 练习模式准备期, 玩家自由准备
// 阶段2 (10秒后): 取消练习模式, 自动开启正式比赛
public taskStartMatchBuffer() {
	g_iBufferCount++;

	// ★ 每轮强制检查模式: 确保始终是训练模式, 防止被其他逻辑改回公共模式
	if (g_iCurrentMode != MODE_TRAINING) {
		training_start();
		chat_print(0, "^3[HNS] ^1检测到模式被更改, 已强制切回训练模式。");
	}

	// 阶段1: 练习模式准备期 (15秒)
	if (g_iBufferCount < 15) {
		// ★ 缓冲期内刷新回合, 每次间隔 1 秒, 共 4 次
		//   在计数 3/4/5/6 时刷新
		//   ★ 最后 8 秒不再刷新, 等服务器自行开启比赛
		if (g_iBufferCount == 3 || g_iBufferCount == 4 || g_iBufferCount == 5 || g_iBufferCount == 6) {
			hns_restart_round(0.5);
		}

		setTaskHud(0, 0.0, 1, 255, 255, 255, 2.0, "练习模式准备期: %d 秒后自动开始比赛!", 15 - g_iBufferCount);
		return;
	}

	// 阶段2: 取消练习模式, 自动开启正式比赛
	if (task_exists(TASK_MATCH_BUFFER)) {
		remove_task(TASK_MATCH_BUFFER);
	}
	// ★ 倒计时结束后先刷新回合，确保干净的状态再进入比赛
	g_bMatchBufferDone = true;
	hns_restart_round(1.0);
	set_task(1.5, "mix_start");
}

// ★ 赞助模式设置: 聊天框出现"赞助局"即默认为赞助比赛
stock set_sponsor_match(id) {
	if (g_bSponsorMatch)
		return;

	// 比赛已开始后无法再改赞助
	if (g_iMatchStatus == MATCH_STARTED)
		return;

	g_bSponsorMatch = true;
	g_iSponsorPlayer = id;

	// 绿色聊天通知 (与赞助赛提示一致)
	client_print_color(0, print_team_default, "^4[赞助赛] ^1%n ^4选择了赞助玩家: ^1%n", id, id);

	// 若缓冲期进行中, 立即重播赞助音效并提示准备期
	if (task_exists(TASK_MATCH_BUFFER)) {
		play_match_about_sound();
		new iRemain = 10 - g_iBufferCount;
		if (iRemain < 0) iRemain = 0;
		setTaskHud(0, 0.0, 1, 255, 255, 255, 2.0, "练习模式准备期: %d 秒后自动开始比赛!", iRemain);
	}
}

public cmdKnifeRound(id) {
	if (!isUserWatcher(id)) {
		return PLUGIN_HANDLED;
	}

	if (g_iCurrentMode != MODE_TRAINING) {
		chat_print(id, "现在无法开始刀战回合。");
		return PLUGIN_HANDLED;
	}

	if (g_iMatchStatus == MATCH_CAPTAINKNIFE || g_iMatchStatus == MATCH_TEAMKNIFE || g_iMatchStatus == MATCH_CUPKNIFE) {
		chat_print(id, "刀战回合已在进行中。");
		return PLUGIN_HANDLED;
	}

	// 只有拼刀地图才能启动拼刀选人（解决boost/其他地图也被拼刀选人的问题）
	if (!hns_is_knife_map()) {
		chat_print(id, "刀战回合仅在刀战地图上可用。");
		return PLUGIN_HANDLED;
	}

	chat_print(id, "%n 已开始刀战回合!", id);

	g_iMatchStatus = MATCH_TEAMKNIFE;
	kniferound_start();

	return PLUGIN_HANDLED;
}

public cmdKnifePickBan(id) {
	if (!isUserWatcher(id)) {
		return PLUGIN_HANDLED;
	}

	if (g_iCurrentMode != MODE_TRAINING) {
		chat_print(id, "请先关闭其他模式再启动刀战 Pick/Ban。");
		return PLUGIN_HANDLED;
	}

	if (g_iMatchStatus == MATCH_CAPTAINKNIFE || g_iMatchStatus == MATCH_TEAMKNIFE || g_iMatchStatus == MATCH_CUPKNIFE) {
		chat_print(id, "刀战 Pick/Ban 回合已在进行中。");
		return PLUGIN_HANDLED;
	}

	chat_print(id, "^3%n^1 已启动 ^3刀战 Pick/Ban^1 回合!", id);

	g_iMatchStatus = MATCH_CUPKNIFE;
	kniferound_start();

	return PLUGIN_HANDLED;
}


