// Очистить роли игроков
stock hns_reset_users_roles() {
	new iPlayers[MAX_PLAYERS], iNum;
	get_players(iPlayers, iNum, "ch");

	for (new i; i < iNum; i++) {
		new id = iPlayers[i];

		g_ePlayerInfo[id][PLAYER_ROLE] = ROLE_SPEC;
	}

	LogSendMessage("[MATCH] Reset users roles");
}

stock getUserKey(id) {
	new szAuth[24];
	get_user_authid(id, szAuth, charsmax(szAuth));
	return szAuth;
}

stock TeamName:getUserTeam(id) {
	return get_member(id, m_iTeam);
}

stock bool:getUserInMatch(id) {
	if (g_iCurrentMode != MODE_MIX && g_iCurrentMode != MODE_ROUNDS && g_iCurrentMode != MODE_ASCENSION && g_iCurrentMode != MODE_VAMP)
		return false;

	new iPlayers[MAX_PLAYERS], iNum;
	get_players(iPlayers, iNum, "ch");

	for (new i; i < iNum; i++) {
		new iPlayer = iPlayers[i];

		if (getUserTeam(iPlayer) == TEAM_SPECTATOR)
			continue;

		if (id == iPlayer)
			return true;
	}
	return false;
}

stock bool:isUserWatcher(id) {
	if (get_user_flags(id) & read_flags(g_szWatcherFlag))
		return true;
	if (is_user_admin(id))
		return true;
	return false;
}

stock bool:isUserFullWatcher(id) {
	if (get_user_flags(id) & read_flags(g_szFullWatcherFlag))
		return true;
	else
		return false;
}

stock bool:isUserAdmin(id) {
	if (get_user_flags(id) & read_flags(g_szAdminFlag))
		return true;
	else
		return false;
}

stock setUserGodmode(index, godmode = 0) {
	set_entvar(index, var_takedamage, godmode == 1 ? DAMAGE_NO : DAMAGE_AIM);
	set_pev(index, pev_takedamage, godmode == 1 ? DAMAGE_NO : DAMAGE_AIM);
	if (godmode) {
		set_pev(index, pev_health, 99999.0);
		set_entvar(index, var_health, 99999.0);
	}
	return 1;
}

// ★ 转观战: 原封不动搬隔壁 OpenHNS 的代码
//   jointeam 6 → SOLID_NOT → MOVETYPE_FLY, 不多做任何多余操作
stock transferUserToSpec(id) {
	setTeam(id, TEAM_SPECTATOR);
	set_pev(id, pev_solid, SOLID_NOT);
	set_pev(id, pev_movetype, MOVETYPE_FLY);

	// ★ FIX 观战卡成"飞行实体"(能移动但观战不了别人):
	//   jointeam 6 后引擎会重置 iuser1/iuser2, 直接在此刻设置会被覆盖,
	//   必须延迟几帧后补设观察模式 (iuser1/iuser2) 才稳定。
	remove_task(TASK_SPEC_INIT + id);
	set_task(0.3, "taskSpecInit", TASK_SPEC_INIT + id);
}

// ★ 延迟初始化观察者模式 (修复"能飞但观战不了别人"的卡实体)
//   只处理仍处于观战队伍、且尚未正确进入观察者模式的死亡玩家:
//   - var_iuser1 = OBS_CHASE_FREE (2, 自由跟随) / 无活人时 OBS_ROAMING (3, 自由视角)
//   - var_iuser2 = 观察目标实体索引 (优先活着的参赛玩家)
//   补设后玩家即可正常用鼠标左右切换观战目标。
public taskSpecInit(taskid) {
	new id = taskid - TASK_SPEC_INIT;

	if (!is_user_connected(id))
		return;
	if (getUserTeam(id) != TEAM_SPECTATOR)
		return;
	if (is_user_alive(id))
		return;

	// 引擎已正常初始化观察模式 (非卡实体状态) 则跳过, 不干扰正常观战
	new iObs = get_entvar(id, var_iuser1);
	if (iObs == OBS_CHASE_LOCKED || iObs == OBS_CHASE_FREE || iObs == OBS_ROAMING || iObs == OBS_IN_EYE)
		return;

	// 找一个真实观战目标 (优先活着的玩家, 自动跳过自己)
	new iTarget = find_observer_target(id);
	if (iTarget) {
		// 自由跟随模式并锁定到该玩家, 之后可用鼠标左右切换别人
		set_entvar(id, var_iuser1, OBS_CHASE_FREE);
		set_entvar(id, var_iuser2, iTarget);
	} else {
		// 暂时没有活人可看: 启用自由视角, 玩家仍可用鼠标滚动切换视角
		set_entvar(id, var_iuser1, OBS_ROAMING);
		set_entvar(id, var_iuser2, 0);
	}
}

// ★ 找一个有效的观察目标: 优先选择活着的玩家, 其次选任意玩家
stock find_observer_target(id) {
	new iPlayers[MAX_PLAYERS], iNum;
	get_players(iPlayers, iNum, "ah"); // 活着的、真实玩家
	if (iNum > 0) {
		// 优先选不是自己的
		for (new i = 0; i < iNum; i++) {
			if (iPlayers[i] != id) return iPlayers[i];
		}
		return iPlayers[0];
	}
	// 没有活着的玩家, 找任意在线玩家
	get_players(iPlayers, iNum, "ch");
	for (new i = 0; i < iNum; i++) {
		if (iPlayers[i] != id) return iPlayers[i];
	}
	return 0;
}

// ★ 强制所有非参赛玩家转入观战 (比赛开始时调用)
stock forceUnmatchedToSpec() {
	new iPlayers[MAX_PLAYERS], iNum;
	get_players(iPlayers, iNum, "ch");

	for (new i = 0; i < iNum; i++) {
		new id = iPlayers[i];
		if (!is_user_connected(id)) continue;

		new TeamName:team = getUserTeam(id);

		// 已在观战队伍的跳过
		if (team == TEAM_SPECTATOR) continue;

		// 未分配队伍的也转观战
		if (team == TEAM_UNASSIGNED) {
			transferUserToSpec(id);
			continue;
		}

		// ★ 已在 T/CT 队伍的玩家视为已参赛, 保留 (兼容 AI 报名插件: 它分好队但不设 PLAYER_ROLE)
		if (team == TEAM_TERRORIST || team == TEAM_CT) {
			continue;
		}

		// 检查是否在比赛角色中 (有角色说明是参赛玩家, 保留)
		if (g_ePlayerInfo[id][PLAYER_ROLE] == ROLE_TEAM_A ||
			g_ePlayerInfo[id][PLAYER_ROLE] == ROLE_TEAM_B ||
			g_ePlayerInfo[id][PLAYER_ROLE] == ROLE_CAP_A ||
			g_ePlayerInfo[id][PLAYER_ROLE] == ROLE_CAP_B) {
			continue;
		}

		// 非参赛玩家强制转观战
		transferUserToSpec(id);
	}
}

stock transferUsers(TeamName:iTeam) {
	new Float:flTime;
	new iPlayers[MAX_PLAYERS], iNum;
	get_players(iPlayers, iNum, "ch");
	for (new i = 0; i < iNum; i++) {
		new id = iPlayers[i];
		if (is_user_connected(id)) {
			switch (id) {
			case 1 ..8: {
				flTime = 0.1;
			}
			case 9 ..16: {
				flTime = 0.2;
			}
			case 17 ..24: {
				flTime = 0.3;
			}
			case 25 ..32: {
				flTime = 0.4;
			}
		}

			new taskParams[2];
			taskParams[0] = id;
			taskParams[1] = _:iTeam;

			set_task(flTime, "taskToTeam", id, taskParams, sizeof taskParams);
		}
	}
}

public taskToTeam(Params[]) {
	new id = Params[0];
	new team = Params[1];
	if (is_user_connected(id)) {
		if (is_user_alive(id))
			user_silentkill(id);

		if (getUserTeam(id) != TeamName:team)
			setTeam(id, TeamName:team);
	}
}

setTeam(id, TeamName:iTeam) {
	set_member(id, m_bTeamChanged, false);

	if (is_user_alive(id))
		user_silentkill(id);

	switch (iTeam) {
		case TEAM_TERRORIST: {
			rg_internal_cmd(id, "jointeam", "1");
			rg_internal_cmd(id, "joinclass", "5");
		}
		case TEAM_CT: {
			rg_internal_cmd(id, "jointeam", "2");
			rg_internal_cmd(id, "joinclass", "5");
		}
		case TEAM_SPECTATOR: {
			rg_internal_cmd(id, "jointeam", "6");
		}
	}
}


stock get_num_players_in_match(iIgnonePlayer = 0) {
	new iPlayers[MAX_PLAYERS], iNum;
	get_players(iPlayers, iNum, "ch");
	new numGameplr;
	for (new i; i < iNum; i++) {
		new tempid = iPlayers[i];

		if (iIgnonePlayer == tempid) {
			continue;
		}

		if (getUserTeam(tempid) != TEAM_TERRORIST && getUserTeam(tempid) != TEAM_CT) {
			continue;
		}

		numGameplr++;
	}
	return numGameplr;
}

stock bool:checkUserBan() {
	new iPlayers[MAX_PLAYERS], iNum;
	get_players(iPlayers, iNum, "ch");

	new bool:foundPlayerBanned = false;

	for (new i; i < iNum; i++) {
		new tempid = iPlayers[i];
		if (getUserTeam(tempid) == TEAM_SPECTATOR) continue;

		if (!e_bBanned[tempid]) continue;

		chat_print(0, "^3%n^1 已被暂停。", tempid);
		transferUserToSpec(tempid);
		foundPlayerBanned = true;	
	}

	if (foundPlayerBanned && g_ModFuncs[g_iCurrentMode][MODEFUNC_PAUSE]) {
		ExecuteForward(g_ModFuncs[g_iCurrentMode][MODEFUNC_PAUSE], _);
	}

	return foundPlayerBanned;
}

stock bool:check_captain_role(TeamName:iTeam) {
	new iPlayers[MAX_PLAYERS], iNum;
	get_players(iPlayers, iNum, "ch");

	for (new i; i < iNum; i++) {
		new id = iPlayers[i];
		if (getUserTeam(id) != iTeam) continue;

		if (g_ePlayerInfo[id][PLAYER_ROLE] == ROLE_CAP_A || g_ePlayerInfo[id][PLAYER_ROLE] == ROLE_CAP_B) {
			return true;
		}
	}
	return false;
}
