			ArrayGetString(g_Owned[target], i, key, charsmax(key));
			new idx = PoolIndexOf(key);
			if (idx != -1)
				SkinTeamShort(id, PoolTeamChar(idx), szTeamTag, charsmax(szTeamTag));
